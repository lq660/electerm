$session-primary = var(--workbench-primary, #426f9d)
$session-primary-strong = var(--workbench-primary-strong, #365f8a)
$session-primary-soft = var(--workbench-primary-soft, #eef3f8)
$session-primary-tint = var(--workbench-primary-tint, #f5f8fb)
$session-primary-border = var(--workbench-primary-border, #c6d5e4)
$session-primary-active-border = var(--workbench-primary-active-border, #b8cadb)
$session-primary-icon-bg = var(--workbench-primary-icon-bg, #e7eef5)

@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 1px
  background var(--text-dark)
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  border 0
  background transparent
  color inherit
  font-family inherit
  line-height 30px
  padding 0 14px 0 0
  margin-right 0px
  font-size 14px
  cursor pointer
  &:hover
  &.active
    color var(--text-light)
  &.active
    .type-tab-line
      display inline-block

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, var(--success) 0%, var(--main) 25%, var(--error) 50%, var(--primary) 75%, var(--success) 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none
.spliter
  color var(--text)
  &:hover
    color var(--text-light)

.sessions
  position absolute
  background var(--main)
.session-wrap
  display none
  position absolute
  overflow hidden
  z-index 3
  padding-top 36px
  box-shadow 0px 0px 1px 1px var(--main-darker)
  &.session-batch-active
    display block

.term-sftp-box
  height 100%

.cn-terminal-session-tabs,
.cn-file-session-tabs
  height 36px
  display flex
  align-items center
  gap 6px
  flex 0 1 auto
  min-width 0
  overflow-x auto
  overflow-y hidden
  padding 4px 4px
  background transparent
  box-sizing border-box

  button
    position relative
    height 26px
    flex 0 0 auto
    display inline-flex
    align-items center
    gap 4px
    padding 0 10px
    border 1px solid #dbe3ef
    border-radius 6px
    background #fff
    color #344054
    cursor pointer
    font-size 12px

    &:not(.add)
      border-color $session-primary-border
      background #fff
      color $session-primary

    &:hover
      border-color $session-primary-active-border
      color $session-primary-strong
      background $session-primary-tint

    &.active
      border-color $session-primary-active-border
      background $session-primary-soft
      color $session-primary-strong
      font-weight 600

    &.add
      margin-left 2px

    &.fixed
      cursor pointer

    &.dragging
      opacity .55

    &.drag-over-before::before,
    &.drag-over-after::after
      content ''
      position absolute
      top 4px
      bottom 4px
      width 2px
      border-radius 2px
      background $session-primary

    &.drag-over-before::before
      left -5px

    &.drag-over-after::after
      right -5px

.cn-terminal-session-close
  width 14px
