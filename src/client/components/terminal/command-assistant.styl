.command-assistant-modal
  .custom-modal-body
    padding 14px

.command-assistant-head
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 12px
  align-items center

  .ant-input-affix-wrapper
    height 36px
    border-color #cfd8e6
    border-radius 6px
    box-shadow none

    &:focus,
    &:focus-within
      border-color #1677ff
      box-shadow 0 0 0 2px rgba(22, 119, 255, .1)

.command-assistant-machine
  min-height 58px
  display flex
  align-items center
  gap 10px
  margin-top 12px
  padding 9px 10px
  border 1px solid #d8e0ea
  border-radius 8px
  background #f8fafc

  > .anticon
    width 30px
    height 30px
    flex 0 0 30px
    display flex
    align-items center
    justify-content center
    border-radius 6px
    background #e8f2ff
    color #1677ff
    font-size 16px

.command-assistant-machine-loading,
.command-assistant-machine-info
  min-width 170px
  display flex
  flex-direction column
  gap 3px

  strong
    overflow hidden
    color #1f2937
    font-size 13px
    text-overflow ellipsis
    white-space nowrap

  span
    overflow hidden
    color #667085
    font-size 12px
    text-overflow ellipsis
    white-space nowrap

  &.error strong
    color #b54708

.command-assistant-machine-info
  width 230px
  flex 0 0 230px

.command-assistant-machine-software
  min-width 0
  flex 1 1 auto
  display flex
  gap 6px
  overflow-x auto
  padding-bottom 1px

  button
    max-width 154px
    height 36px
    flex 0 0 auto
    display flex
    flex-direction column
    justify-content center
    gap 1px
    padding 0 8px
    border 1px solid #d8e0ea
    border-radius 6px
    background #fff
    color #344054
    cursor pointer
    text-align left

    &:hover
      border-color #1677ff
      background #eef5ff

    b,
    span
      display block
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

    b
      font-size 12px

    span
      color #667085
      font-size 10px

.command-assistant-machine-refresh
  width 30px
  height 30px
  flex 0 0 30px
  display inline-flex
  align-items center
  justify-content center
  padding 0
  border 1px solid #d8e0ea
  border-radius 6px
  background #fff
  color #667085
  cursor pointer

  &:hover
    border-color #1677ff
    color #1677ff

  &:disabled
    cursor default
    opacity .6

.command-assistant-basic
  height 38px
  display inline-flex
  align-items center
  gap 7px
  margin-top 12px
  padding 0 10px
  border 1px solid #d8e0ea
  border-radius 6px
  background #f8fafc
  color #667085
  font-size 12px

  > .anticon
    color #1677ff

.command-assistant-system
  height 36px
  display flex
  align-items center
  gap 4px
  padding 3px
  border 1px solid #d8e0ea
  border-radius 6px
  background #f5f7fb

  > span
    padding 0 6px
    color #667085
    font-size 12px

  button
    height 28px
    padding 0 10px
    border 0
    border-radius 5px
    background transparent
    color #667085
    cursor pointer

    &.active
      background #fff
      color #1677ff
      box-shadow 0 1px 3px rgba(15, 23, 42, .12)

.command-assistant-categories
  display flex
  gap 6px
  margin 12px 0
  overflow-x auto

  button
    height 28px
    flex 0 0 auto
    padding 0 10px
    border 1px solid #d8e0ea
    border-radius 6px
    background #fff
    color #667085
    cursor pointer

    &:hover,
    &.active
      border-color #1677ff
      background #eef5ff
      color #1677ff

.command-assistant-layout
  height 470px
  display grid
  grid-template-columns 300px minmax(0, 1fr)
  overflow hidden
  border 1px solid #d8e0ea
  border-radius 8px

.command-assistant-results
  overflow-y auto
  padding 6px
  border-right 1px solid #d8e0ea
  background #f8fafc

  > button
    width 100%
    min-height 58px
    display grid
    grid-template-columns 20px minmax(0, 1fr)
    gap 8px
    align-items start
    padding 9px 10px
    border 1px solid transparent
    border-radius 6px
    background transparent
    color #344054
    cursor pointer
    text-align left

    &:hover
      background #eef5ff

    &.active
      border-color #b8d2ff
      background #e8f2ff
      color #1677ff

    > .anticon
      margin-top 2px

    span
      min-width 0

    b,
    em
      display block

    b
      margin-bottom 3px
      font-size 13px
      line-height 18px

    em
      overflow hidden
      color #667085
      font-size 12px
      font-style normal
      line-height 17px

.command-assistant-empty
  padding 40px 12px
  color #98a2b3
  text-align center

.command-assistant-detail
  min-width 0
  display flex
  flex-direction column
  overflow-y auto
  padding 18px
  background #fff

.command-assistant-detail-title
  > span
    display inline-flex
    height 22px
    align-items center
    padding 0 7px
    border-radius 5px
    background #eef5ff
    color #1677ff
    font-size 12px

  strong
    display block
    margin-top 9px
    color #1f2937
    font-size 17px
    line-height 24px

  p
    margin 5px 0 0
    color #667085
    font-size 13px
    line-height 20px

.command-assistant-operation-section
  margin-top 14px

.command-assistant-operation-label
  margin-bottom 6px
  color #344054
  font-size 12px
  font-weight 600

.command-assistant-operations
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 7px

  button
    min-width 0
    min-height 48px
    display flex
    flex-direction column
    justify-content center
    gap 3px
    padding 7px 9px
    border 1px solid #d8e0ea
    border-radius 6px
    background #fff
    color #344054
    cursor pointer
    text-align left

    &:hover,
    &.active
      border-color #1677ff
      background #eef5ff
      color #1677ff

    &.risk-change em
      color #b54708

    &.risk-danger em
      color #d92d20

    span,
    em
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

    span
      font-size 12px
      font-weight 600

    em
      color #039855
      font-size 10px
      font-style normal

.command-assistant-params
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 10px
  margin-top 16px

  label
    min-width 0

    > span
      display block
      margin-bottom 5px
      color #344054
      font-size 12px
      font-weight 600

  .ant-input
    height 32px
    border-color #cfd8e6
    border-radius 6px

.command-assistant-preview-label
  margin-top 16px
  color #344054
  font-size 12px
  font-weight 600

.command-assistant-preview
  min-height 82px
  max-height 130px
  margin 6px 0 0
  overflow auto
  padding 12px
  border 1px solid #d8e0ea
  border-radius 6px
  background #111827
  color #e5edf8
  font-family ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
  font-size 12px
  line-height 19px
  white-space pre-wrap
  word-break break-all

.command-assistant-risk
  display flex
  align-items center
  gap 6px
  margin-top 8px
  padding 7px 9px
  border 1px solid #fed7aa
  border-radius 6px
  background #fff7ed
  color #b54708
  font-size 12px
  line-height 18px

  &.risk-danger
    border-color #fecdca
    background #fef3f2
    color #d92d20

.command-assistant-confirm
  display grid
  grid-template-columns 28px minmax(0, 1fr)
  gap 10px
  align-items start

  > .anticon
    margin-top 2px
    color #f79009
    font-size 22px

  strong
    display block
    color #1f2937
    font-size 14px

  p
    margin 5px 0 10px
    color #667085
    line-height 20px

  code
    display block
    overflow auto
    padding 9px
    border-radius 6px
    background #111827
    color #e5edf8
    font-size 12px
    line-height 18px
    white-space pre-wrap
    word-break break-all

.command-assistant-target
  margin-top auto
  padding-top 12px
  color #667085
  font-size 12px

.command-assistant-actions
  display flex
  justify-content flex-end
  gap 8px
  margin-top 10px

  button
    height 34px
    display inline-flex
    align-items center
    justify-content center
    gap 6px
    padding 0 14px
    border-radius 6px
    cursor pointer

    &.secondary
      border 1px solid #b8d2ff
      background #eef5ff
      color #1677ff

    &.primary
      border 1px solid #1677ff
      background #1677ff
      color #fff

@media (max-width: 760px)
  .command-assistant-modal .custom-modal-content
    width calc(100vw - 24px) !important

  .command-assistant-head
    grid-template-columns 1fr

  .command-assistant-system
    width max-content

  .command-assistant-machine
    align-items flex-start
    flex-wrap wrap

  .command-assistant-machine-info
    width calc(100% - 82px)
    flex-basis calc(100% - 82px)

  .command-assistant-machine-software
    width 100%
    order 2

  .command-assistant-layout
    height 62vh
    grid-template-columns 1fr
    grid-template-rows 180px minmax(0, 1fr)

  .command-assistant-operations
    grid-template-columns repeat(2, minmax(0, 1fr))

  .command-assistant-results
    border-right 0
    border-bottom 1px solid #d8e0ea
