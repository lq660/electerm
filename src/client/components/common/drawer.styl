.custom-drawer
  position fixed
  top 0
  // 2026-09-22 coder(lq): Global drawers cover the full window now that the persistent left rail has been removed.
  left 0
  right 0
  bottom 0

.custom-drawer-mask
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  background rgba(0, 0, 0, 0.45)

.custom-drawer-content-wrapper
  position absolute
  top 0
  bottom 0
  background var(--main)
  box-shadow 2px 0 8px rgba(0, 0, 0, 0.15)
  overflow auto
  color var(--text)

.custom-drawer-left .custom-drawer-content-wrapper
  left 0

.custom-drawer-right .custom-drawer-content-wrapper
  right 0

.custom-drawer-content
  position relative
  height 100%
  width 100%

// 2026-07-02 coder(lq): Drawers are shared by settings and side workflows; force neutral surfaces after legacy dark theme styles load.
.custom-drawer-mask
  background rgba(15, 23, 42, .12) !important

.custom-drawer-content-wrapper,
.custom-drawer-content
  background #f5f7fb !important
  color #1f2937 !important

// 2026-09-22 coder(lq): Settings and resource management use the same shell, but a modal variant keeps them visually separate from the main workspace.
.custom-drawer-modal
  left 0
  display flex
  align-items center
  justify-content center
  padding 28px 32px
  box-sizing border-box

  .custom-drawer-content-wrapper
    position relative
    top auto
    bottom auto
    left auto !important
    right auto !important
    width calc(100vw - 64px)
    height calc(100vh - 56px)
    max-width 1480px
    max-height 940px
    border 1px solid var(--workbench-border-strong, #d8e0ea)
    border-radius 10px
    box-shadow 0 24px 64px rgba(15, 23, 42, .22)
    overflow hidden
    z-index 1
    outline none

  .custom-drawer-content
    overflow hidden

@media (max-width: 760px), (max-height: 620px)
  .custom-drawer-modal
    padding 10px

    .custom-drawer-content-wrapper
      width calc(100vw - 20px)
      height calc(100vh - 20px)
      border-radius 8px
