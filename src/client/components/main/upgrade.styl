.upgrade-panel
  position fixed
  right 10px
  bottom 10px
  z-index 888
  background var(--main)
  border-radius 5px
  border 1px solid var(--main-darker)
  padding 0
  width 440px
.upgrade-panel-hide
  left -600px
  top 400px
  right auto
  bottom auto
.close-upgrade-panel
  &:hover
    color var(--success)
.upgrade-panel-title
.upgrade-panel-body
  padding 10px 15px
.upgrade-panel-title
  border-bottom 1px solid var(--main-darker)
.markdown-wrap
  max-height 20vh
  overflow-y auto

// 2026-07-02 coder(lq): Upgrade prompts are product notices and should not inherit terminal dark surfaces.
.upgrade-panel
  background #fff !important
  color #1f2937 !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  box-shadow 0 18px 48px rgba(15, 23, 42, .16) !important
  overflow hidden

.upgrade-panel-title
  background #fbfdff !important
  border-bottom 1px solid #d8e0ea !important
  color #1f2937 !important

.upgrade-panel-body,
.markdown-wrap
  color #344054 !important

.cn-upgrade-title
  min-height 58px
  display flex
  align-items center

  .fleft
    display flex
    flex-direction column
    gap 4px
    line-height 1.35

    b
      font-size 16px
      color #0f172a

  .fright
    padding-top 3px

.cn-upgrade-version
  font-size 12px
  color #667085

.cn-upgrade-summary
  border 1px solid #d6e6ff
  background #f5f9ff
  color #24528f
  border-radius 6px
  padding 10px 12px
  line-height 1.6
  margin-bottom 12px

.cn-upgrade-actions
  display flex
  align-items flex-start
  flex-wrap wrap
  gap 8px

  .ant-space-compact
    margin-bottom 8px

  .mg1l
    margin-left 0

.cn-upgrade-links
  p
    margin 0 0 8px
    color #475467

  a
    color #1677ff !important

.cn-upgrade-changelog
  border-top 1px solid #e6edf5
  margin-top 8px

  .bold
    color #0f172a
    margin-bottom 4px

.cn-upgrade-changelog-note
  color #667085
  font-size 12px
  line-height 1.6
  margin-bottom 8px

.cn-upgrade-changelog
  .markdown-wrap
    border 1px solid #e6edf5
    border-radius 6px
    background #fbfdff
    padding 8px 10px
    margin-bottom 8px

.upgrade-panel
  .ant-select
    background #fff !important
    color #1f2937 !important
    border-color #cfd8e6 !important
    border-radius 6px !important

  .ant-select-selector
    height 32px !important
    border-color #cfd8e6 !important
    border-radius 6px !important
    background #fff !important
    color #1f2937 !important

  .ant-btn
    border-radius 6px !important
    border-color #cfd8e6 !important
    background #fff !important
    color #344054 !important
    box-shadow none !important

    &:hover
      border-color #1677ff !important
      color #1677ff !important

  .ant-btn-primary
    border-color #1677ff !important
    background #1677ff !important
    color #fff !important

    &:hover
      border-color #0958d9 !important
      background #0958d9 !important
      color #fff !important

.close-upgrade-panel:hover
  color #1677ff !important
