// 2026-07-02 coder(lq): Global product skin for a China-oriented operations workbench while keeping electerm's existing component logic intact.
$cn-bg = #f4f7fb
$cn-panel = #ffffff
$cn-panel-soft = #fbfdff
$cn-border = #dbe3ef
$cn-border-soft = #edf1f7
$cn-text = #1f2937
$cn-muted = #667085
$cn-primary = #1769e0
$cn-primary-soft = #eef5ff
$cn-success = #12b76a
$cn-warning = #f79009
$cn-danger = #f04438
$cn-dark = #101828

html,
body,
#container
  // 2026-07-04 coder(lq): Keep the app shell edge-to-edge; otherwise Electron's window background can show as dark right/bottom borders after resize.
  width 100%
  height 100%
  min-width 100vw
  min-height 100vh
  margin 0
  background $cn-bg

#container
  .loaded
    width 100vw
    height 100vh
    min-width 100vw
    min-height 100vh
    overflow hidden
    background $cn-bg

  #outside-context
    width 100vw
    height 100vh
    overflow hidden

  // 2026-07-03 coder(lq): Normalize the top-level workbench frame so legacy dark terminal chrome cannot leak as black edges around the sidebar or title bar.
  .layout-wrap,
  .layout-item,
  .tabs-outer,
  .app-drag
    background $cn-bg !important

  .layout-item
    border-color $cn-border !important

  .ant-btn
    border-radius 6px
    box-shadow none
    font-weight 500

  .ant-btn-primary
    background $cn-primary
    border-color $cn-primary

  .ant-input,
  .ant-input-affix-wrapper,
  .ant-select,
  .ant-select-selector,
  .ant-input-number,
  .ant-picker
    border-radius 6px !important
    border-color $cn-border !important
    box-shadow none !important

  .ant-select
    background $cn-panel !important
    color $cn-text !important

  .ant-select-arrow,
  .ant-select-selection-item
    color $cn-muted !important

  .ant-input:focus,
  .ant-input-affix-wrapper-focused,
  .ant-select-focused .ant-select-selector,
  .ant-input-number-focused,
  .ant-picker-focused
    border-color $cn-primary !important

  // 2026-07-20 coder(lq): Compound inputs such as password fields draw their border on the wrapper; keep the inner input borderless to avoid a double-frame focus state.
  .ant-input-affix-wrapper .ant-input,
  .ant-input-affix-wrapper .ant-input:focus
    border 0 !important
    box-shadow none !important
    background transparent !important

  .ant-tabs-tab
    padding 8px 0

  .ant-tabs-tab-active .ant-tabs-tab-btn
    color $cn-primary
    font-weight 600

  .ant-tabs-ink-bar
    background $cn-primary

  .ant-modal-content,
  .custom-modal-content
    border-radius 8px
    border 1px solid $cn-border
    box-shadow 0 18px 50px rgba(15, 23, 42, .16)
    background $cn-panel

  .custom-modal-header
    padding 14px 18px
    background $cn-panel-soft
    border-bottom 1px solid $cn-border

  .custom-modal-title
    color $cn-text
    font-size 15px

  .custom-modal-body
    padding 18px

  .custom-modal-footer
    padding 12px 18px
    background $cn-panel-soft
    border-top 1px solid $cn-border

  .custom-modal-ok-btn,
  .custom-modal-cancel-btn
    border-radius 6px

  .custom-modal-ok-btn
    background $cn-primary

  .custom-modal-cancel-btn
    border 1px solid $cn-border

  .sidebar
    background $cn-dark
    border-right 1px solid #0b1220

  .sidebar-bar.btns
    background $cn-dark

  .control-icon-wrap
    padding 12px 0

  .control-icon-wrap .control-icon,
  .btns .open-about-icon
    color #8ea0b8

  .control-icon-wrap.active .control-icon,
  .control-icon-wrap .control-icon:hover,
  .btns .open-about-icon:hover
    color #ffffff

  .sidebar-panel
    background $cn-panel
    border-right 1px solid $cn-border
    box-shadow 10px 0 24px rgba(15, 23, 42, .08)

  .type-transfer
    .cn-transfer-side-panel
      width 100% !important
      overflow hidden !important

  .sidebar-pin-top
    background $cn-panel-soft
    border-bottom 1px solid $cn-border

  .sidebar-panel-bookmarks,
  .sidebar-panel-history
    top 104px

  .tabs
    background $cn-dark
    border-bottom 1px solid #0b1220

  .tab
    background transparent
    color #98a2b3
    border-radius 6px 6px 0 0
    margin 4px 2px 0 0
    line-height 32px
    height 32px

    &.active
      background $cn-panel
      color $cn-text
      font-weight 600

    &:hover
      background rgba(255, 255, 255, .08)
      color #ffffff

    &.active:hover
      background $cn-panel
      color $cn-text

  .tab-close
    background rgba(15, 23, 42, .08)
    color $cn-muted

    &:hover
      background $cn-danger
      color #fff

  .tabs-extra,
  .tabs-add-btn,
  .tab-scroll-icon
    color #98a2b3

  .tabs-extra:hover,
  .tabs-add-btn:hover,
  .tab-scroll-icon:hover
