
.error-wrapper
  background var(--main)
  height 100%
  position fixed
  overflow-y scroll
  inset 0

.cn-error-logo
  width 52px
  height 52px
  margin-bottom 16px
  color #1677ff

.cn-error-actions
  display flex
  gap 8px
  margin 12px 0

.cn-error-stack
  max-width 960px
  overflow auto

.cn-error-command
  max-width 960px
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 10px 12px
  border 1px solid #dbe3ef
  border-radius 6px
  background #f8fafc

  code
    overflow-wrap anywhere

  .anticon
    flex none
    cursor pointer

#container
  .xterm
    padding 10px
  .session-batch-active
    .xterm-screen
      &::before
        font-size 30vmin
        font-weight bold
        color var(--text)
        display flex
        justify-content center
        align-items center
        position absolute
        top 0
        left 0
        right 0
        bottom 0
        z-index -1
