  .cn-setting-logo
    width 38px
    height 38px
    display inline-flex
    align-items center
    justify-content center
    border-radius 8px
    color #fff
    background $cn-primary

  .cn-setting-status
    display flex
    align-items center
    gap 8px
    color $cn-muted
    font-size 12px

    b
      color $cn-success
      background #ecfdf3
      border 1px solid #abefc6
      border-radius 999px
      padding 2px 8px

  .close-setting-wrap
    top 30px

  .alt-close-setting-wrap
    display none

  .setting-tabs
    top 86px
    background $cn-panel
    border-bottom 1px solid $cn-border
    box-shadow 0 6px 18px rgba(15, 23, 42, .05)
    padding 12px 20px 0 50px

    .ant-tabs-nav
      margin 0

    .ant-tabs-tab
      border-radius 6px 6px 0 0 !important
      padding 8px 16px !important

  .setting-row
    top 154px
    background $cn-bg !important

  .setting-row-right
    top 154px
    padding 16px 18px 28px

  .setting-row-left
    top 154px
    padding 16px 0 18px 16px

  .setting-row-left,
  .setting-row-right
    background $cn-bg

  .setting-row-left .model-bookmark-tree-wrap,
  .setting-row-right > div,
  .setting-col
    border-radius 8px

  .setting-row-left .model-bookmark-tree-wrap,
  .item-list,
  .form-wrap,
  .setting-row-right > div
    background $cn-panel
    border 1px solid $cn-border
    box-shadow 0 8px 22px rgba(15, 23, 42, .04)

  .setting-tabs-bookmarks
