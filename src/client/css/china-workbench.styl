  .cn-connection-form-body
    padding 22px 28px !important
    max-width 980px
    margin 0 auto

  .cn-connection-form .ant-form-item
    margin-bottom 14px

  .cn-connection-form .ant-form-item-row
    display flex
    gap 12px
    align-items center
    flex-wrap nowrap

  .cn-connection-form .ant-col,
  .cn-connection-form .ant-col-sm-8,
  .cn-connection-form .ant-col-sm-16,
