.term-search-wrap
  position absolute
  top 100px
  right 12px
  z-index 200
  width calc(100vw - 96px)
  max-width 520px
  color #1f2937

  .ant-input-affix-wrapper
    min-height 42px
    padding 5px 7px 5px 12px
    border 1px solid #b9c8dc !important
    border-radius 8px !important
    background #fff !important
    box-shadow 0 10px 26px rgba(15, 23, 42, .18) !important

    &:hover,
    &.ant-input-affix-wrapper-focused
      border-color #1677ff !important
      box-shadow 0 0 0 2px rgba(22, 119, 255, .12), 0 10px 26px rgba(15, 23, 42, .16) !important

  .ant-input
    min-width 80px
    padding 0
    border 0 !important
    background transparent !important
    color #1f2937 !important
    font-size 14px
    line-height 30px

    &::placeholder
      color #98a2b3 !important

  .ant-input-suffix
    display inline-flex
    align-items center
    gap 3px
    margin-left 8px
    color #667085

.term-search-opt-icon,
.term-search-act
  width 28px
  height 28px
  display inline-flex
  align-items center
  justify-content center
  margin 0
  border-radius 6px
  color #667085 !important
  cursor pointer
  font-size 15px

  &:hover
    background #eef5ff !important
    color #1677ff !important

.term-search-opt-icon.term-search-on
  background #e6f1ff !important
  color #1677ff !important

.term-search-action-close
  margin-left 3px
  color #98a2b3 !important

  &:hover
    background #fef3f2 !important
    color #d92d20 !important

.term-search-match-count
  min-width 44px
  padding 0 4px
  color #667085
  font-size 12px
  text-align center
  white-space nowrap

@media (max-width: 720px)
  .term-search-wrap
    top 92px
    right 8px
    width calc(100vw - 80px)

  .term-search-match-count
    display none
