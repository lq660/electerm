.cn-logo-title
  display flex
  align-items center
  justify-content center
  gap 12px
  font-size 34px
  color #16324f
  letter-spacing 0
.cn-logo-mark
  width 84px
  height 84px
  display inline-flex
  align-items center
  justify-content center
  border-radius 22px
  color #1677ff
  box-shadow 0 18px 42px rgba(24, 119, 242, .22)

.cn-logo-mark-icon
  display block
  width 100%
  height 100%
.cn-logo-name
  font-weight 700
@media (max-width: 500px)
  .cn-logo-title
    gap 8px
    font-size 22px
  .cn-logo-mark
    width 56px
    height 56px
    border-radius 16px
