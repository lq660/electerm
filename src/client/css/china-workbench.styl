  .cn-bookmark-form .ant-select-selection-item,
  .cn-bookmark-form .ant-select-selection-placeholder
    color $cn-text !important

  .cn-bookmark-form .ant-select-selection-placeholder
    color #98a2b3 !important

  .cn-bookmark-form .ant-input-affix-wrapper .ant-input
    background transparent !important

  .cn-bookmark-form .ant-switch
