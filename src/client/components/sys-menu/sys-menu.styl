.context-menu
  position: relative
  width 300px

.context-item
  -webkit-app-region no-drag
  position relative
  height 28px
  line-height 28px
  padding 0 16px
  &:hover
    background #08c
    color #eee
    cursor pointer
  &.disabled
    color var(--text-disabled)
    &:hover
      color #777
      background #333
      cursor not-allowed
  &.zoom-item
    height 36px
    line-height 36px
    &:hover
      background transparent

.context-sub-text
  position absolute
  right 16px
  top 0
  color var(--text-light)

.context-menu
  hr
    margin 0
    border none
    border-bottom 1px solid var(--main-darker)
.sub-context-menu
  display none
  width 200px
  position absolute
  left 100%
  top 0
  background var(--main)
  box-shadow 0px 0px 3px 3px var(--main-darker)
  max-height 300px
  overflow-y scroll
  color var(--text)
.with-sub-menu
  &:hover
    .sub-context-menu
      display block

.sub-context-menu-item
  cursor pointer
  padding 5px 16px
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  &:hover, &.active
    background-color #08c
    color #eee
.bookmarks-sub-context-menu
  width 380px
  padding 20px 10px 10px 20px

.menu-control
  width 28px
  height 28px
  border-radius 30px
  color var(--text)
  font-size 16px
  text-align center
  display inline-block
  line-height 28px
  cursor pointer
  color var(--text)

.menu-logo
  display inline-block
  width 28px
  height 28px
  vertical-align middle
  color var(--text-disabled)
  &:hover
    color var(--text)
  svg
    fill currentColor
    width 100%
    height 100%

// 2026-07-02 coder(lq): Context menus are app pages users operate frequently; normalize them to the light workbench menu style.
.context-menu,
.sub-context-menu
  background #fff !important
  color #1f2937 !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  box-shadow 0 14px 36px rgba(15, 23, 42, .14) !important

.context-menu
  hr
    border-bottom 1px solid #edf1f7 !important

.context-item,
.sub-context-menu-item
  color #344054 !important
  border-radius 6px !important
  &:hover,
  &.active
    background #eef5ff !important
    color #1677ff !important

.context-item.disabled
  color #98a2b3 !important
  &:hover
    background #f8fafc !important
    color #98a2b3 !important

.context-sub-text,
.menu-control,
.menu-logo
  color #667085 !important

.menu-control:hover,
.menu-logo:hover
  color #1677ff !important

// 2026-07-04 coder(lq): Reframe the app menu as a compact Chinese control panel instead of the upstream large context list.
.cn-app-menu-popover
  background transparent !important
  box-shadow none !important

  .ant-popover-arrow
    display none !important

  .ant-popover-content
    background transparent !important
    box-shadow none !important

  .ant-popover-inner
    padding 0 !important
    border 0 !important
    border-radius 10px !important
    background transparent !important
    overflow hidden
    box-shadow none !important

  .ant-popover-inner-content
    padding 0 !important
    background transparent !important

.context-menu
  width 292px !important
  padding 8px !important
  box-sizing border-box
  border-radius 10px !important
  font-size 13px !important
  border 1px solid #d8e0ea !important
  background #fff !important
  box-shadow 0 18px 44px rgba(15, 23, 42, .16) !important

.context-menu-inner
  display flex
  flex-direction column
  gap 2px

.context-menu-group-title
  height 22px
  line-height 22px
  margin 7px 4px 2px
  color #98a2b3
  font-size 11px
  font-weight 700

  &:first-child
    margin-top 0

.context-item
  display grid !important
  grid-template-columns 22px minmax(0, 1fr) auto
  align-items center
  gap 8px
  height 34px !important
  line-height 34px !important
  padding 0 10px !important
  border-radius 7px !important
  font-size 13px !important
  font-weight 600

  > .anticon
    color #667085
    font-size 15px

  &:hover > .anticon
    color #1677ff

  &.with-sub-menu:after
    content '›'
    color #98a2b3
    font-size 18px
    line-height 1

  &.context-item-secondary
    color #667085 !important
    font-weight 500

  &.context-item-danger
    color #b42318 !important

    > .anticon
      color #f04438

    &:hover
      background #fff1f0 !important
      color #b42318 !important

.context-sub-text
  position static !important
  justify-self end
  color #98a2b3 !important
  font-size 12px
  font-weight 600

.context-item.zoom-item
  display block !important
  height auto !important
  line-height normal !important
  padding 6px 8px !important

  &:hover
    background transparent !important

.cn-menu-zoom-control
  display grid
  grid-template-columns 78px minmax(0, 1fr)
  align-items center
  gap 8px
  color #344054
  font-size 13px
  font-weight 600

  > span
    color #667085

  .input-confirm
    width 100%

  .ant-input-number
    width 100% !important
    height 30px !important
    border-color #d8e0ea !important
    border-radius 6px !important
    background #fff !important
    color #1f2937 !important

  .ant-input-number-input
    height 28px !important
    color #1f2937 !important
    font-size 13px !important
    font-weight 600 !important

  .ant-space-compact
    align-items center

  .ant-space-compact .anticon
    width 24px
    height 24px
    line-height 24px
    margin 0 3px 0 0 !important
    border-radius 6px
    color #667085
    text-align center

    &:hover
      background #eef5ff
      color #1677ff

.sub-context-menu
  width 240px !important
  top -8px !important
  left calc(100% + 10px) !important
  padding 8px !important
  box-sizing border-box
  border-radius 10px !important
  max-height 360px !important
  overflow-y auto !important

.sub-context-menu-item
  height 32px
  line-height 32px
  padding 0 10px !important
  border-radius 7px !important
  font-size 13px
  font-weight 600

.bookmarks-sub-context-menu
  width 360px !important
  padding 10px !important

// 2026-07-04 coder(lq): Replace the upstream pictogram with a compact product mark that matches the China workbench sidebar.
.cn-menu-logo-mark
  width 34px !important
  height 34px !important
  line-height 1 !important
  border-radius 10px
  background linear-gradient(135deg, #1677ff 0%, #0ea5e9 100%)
  color #fff !important
  font-size 20px
  font-weight 800
  letter-spacing 0
  text-align center
  box-shadow 0 8px 16px rgba(22, 119, 255, .22)
  display inline-flex !important
  align-items center
  justify-content center

  &:hover
    background linear-gradient(135deg, #1769e0 0%, #0891b2 100%)
    color #fff !important

.cn-yunduo-logo-glyph
  display block
  color #fff
  line-height 1
  transform translateY(-1px)
