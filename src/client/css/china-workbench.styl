      font-size 13px
      font-weight 500
      height 36px
      line-height 36px

      &:after
        margin-inline 4px 0

  .cn-connection-form .ant-form-item-control
    flex 1 1 auto !important
    min-width 0
    width auto

  .cn-connection-form .ant-form-item-control-input
    min-height 36px

  .cn-field-title,
  .cn-field-host,
  .cn-field-username,
  .cn-field-password,
  .cn-field-category,
  .cn-field-description,
  .cn-field-setEnv,
  .cn-field-startDirectoryLocal,
  .cn-field-startDirectory,
  .cn-field-interactiveValues,
  .cn-field-envLang,
  .cn-field-encode,
  .cn-field-auth-type
