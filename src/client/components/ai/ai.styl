.ai-chat-container
  height 100%
  display flex
  flex-direction column

  &.ai-chat-embedded
    .cn-ai-chat-intro
      margin-bottom 8px
      padding 10px

      > .anticon
        display none

    .cn-ai-config-notice
      margin 0 0 8px

    .cn-ai-empty-state
      padding 8px 0

    .ai-chat-input
      margin-top 8px

    .ai-chat-terminals
      gap 6px

      .cn-ai-control-row
        gap 6px

.cn-ai-chat-intro
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 0 0 10px
  padding 12px
  border 1px solid #d8e0ea
  border-radius 8px
  background #f8fafc
  color #344054

  strong,
  span
    display block

  strong
    color #1f2937
    font-size 14px

  span
    margin-top 4px
    color #667085
    font-size 12px
    line-height 18px

  > .anticon
    color #1677ff
    font-size 18px

  b
    flex 0 0 auto
    padding 2px 8px
    border-radius 999px
    font-size 12px

    &.ready
      background #ecfdf3
      color #039855

    &.missing
      background #fff4e5
      color #b54708

.ai-chat-history
  flex-grow 1
  min-height 0
  flex-direction column
  overflow-y auto
  overflow-x hidden
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background #cbd5e1
    border-radius 999px
  &::-webkit-scrollbar-track
    background transparent

// 2026-08-30 coder(lq): Treat the archive as a compact secondary control so the active conversation remains the visual focus.
.cn-ai-history-navigator
  flex 0 0 auto
  margin 0 0 6px
  padding 0 0 5px
  border-bottom 1px solid var(--workbench-border-soft, #edf1f7)
  background transparent

.cn-ai-history-toolbar
  display flex
  align-items center
  justify-content space-between
  gap 8px
  min-height 28px

.cn-ai-history-toolbar-actions
  display flex
  align-items center
  gap 6px
  margin-left 0

.cn-ai-history-toolbar-label
  flex 0 0 auto
  color var(--workbench-muted, #667085)
  font-size 11px
  font-weight 600

// 2026-09-04 coder(lq): Keep transcript search beside the session actions so it reads as a session-level control and remains visible while the transcript scrolls.
.cn-ai-history-toolbar > .ai-history-search-toolbar
  min-width 140px
  max-width 420px
  margin-left auto
  margin-right 2px

.cn-ai-new-session-button
  display inline-flex
  align-items center
  gap 5px
  height 26px
  padding 0 9px
  border 1px solid var(--workbench-border, #d8e0ea)
  border-radius 6px
  background var(--workbench-panel, #fff)
  color var(--workbench-control-text, #344054)
  font-family inherit
  font-size 12px
  font-weight 600
  cursor pointer

  &:hover,
  &[aria-pressed='true']
    border-color var(--workbench-primary-border, #b8d8ff)
    background var(--workbench-primary-soft, #eef5ff)
    color var(--workbench-primary, #1677ff)

  &:focus-visible
    outline 2px solid var(--workbench-primary, #1677ff)
    outline-offset 1px

.cn-ai-history-button
  display inline-flex
  align-items center
  justify-content center
  height 26px
  padding 0 9px
  border 1px solid var(--workbench-border, #d8e0ea)
  border-radius 6px
  background var(--workbench-panel, #fff)
  color var(--workbench-control-text, #344054)
  font-family inherit
  font-size 12px
  font-weight 600
  cursor pointer

  &:hover,
  &:focus-visible
    border-color var(--workbench-primary-border, #b8d8ff)
    background var(--workbench-primary-soft, #eef5ff)
    color var(--workbench-primary, #1677ff)

  &:focus-visible
    outline 2px solid var(--workbench-primary, #1677ff)
    outline-offset 1px

.cn-ai-history-modal .custom-modal-body
  padding-top 16px

.cn-ai-history-filter
  display flex
  gap 6px
  margin-bottom 12px
  padding-bottom 10px
  border-bottom 1px solid var(--workbench-border-soft, #edf1f7)

.cn-ai-history-filter-button
  flex 1 1 0
  min-width 0
  height 28px
  padding 0 8px
  border 1px solid transparent
  border-radius 6px
  background transparent
  color var(--workbench-muted, #667085)
  font-family inherit
  font-size 11px
  cursor pointer
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

  &:hover,
  &:focus-visible,
  &.is-active
    border-color var(--workbench-primary-border, #b8d8ff)
    background var(--workbench-primary-soft, #eef5ff)
    color var(--workbench-primary, #1677ff)

  &:focus-visible
    outline 2px solid var(--workbench-primary, #1677ff)
    outline-offset 1px

.cn-ai-history-modal-list
  display flex
  flex-direction column
  gap 6px
  max-height min(60vh, 520px)
  overflow-y auto

.cn-ai-history-modal-item
  display block
  width 100%
  padding 10px 12px
  border 1px solid var(--workbench-border-soft, #edf1f7)
  border-radius 7px
  background var(--workbench-panel, #fff)
  color var(--workbench-text, #1f2937)
  text-align left
  cursor pointer

  &:hover,
  &:focus-visible,
  &.is-active
    border-color var(--workbench-primary-border, #b8d8ff)
    background var(--workbench-primary-soft, #eef5ff)

  &:focus-visible
    outline 2px solid var(--workbench-primary, #1677ff)
    outline-offset 1px

.cn-ai-history-modal-item-title,
.cn-ai-history-modal-item-meta
  display block
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.cn-ai-history-modal-item-title
  color var(--workbench-text, #1f2937)
  font-size 13px
  font-weight 600
  line-height 19px

.cn-ai-history-modal-item-meta
  margin-top 3px
  color var(--workbench-muted, #667085)
  font-size 11px
  line-height 16px

.cn-ai-history-modal-empty
  padding 28px 8px
  color var(--workbench-muted, #667085)
  font-size 13px
  text-align center
.ai-history-wrap
  width 100%
  // 2026-08-30 coder(lq): Keep the history at its content height so the parent owns a reliable scrollbar during streaming output.
  flex 0 0 auto
  min-height 0
  overflow visible
  overflow-x hidden

.ai-conversation-group
  margin-bottom 12px

  &.is-multi-round
    padding 8px
    border 1px solid var(--workbench-border-soft, #edf1f7)
    border-radius 10px
    background var(--workbench-panel, #fff)

    .chat-history-item
      margin-bottom 6px

    .chat-history-item:last-child
      margin-bottom 0

.ai-conversation-group-header
  display flex
  align-items center
  gap 8px
  min-width 0
  padding 2px 6px 8px
  color var(--workbench-text, #1f2937)

  strong
    min-width 0
    overflow hidden
    color var(--workbench-text, #1f2937)
    font-size 14px
    line-height 20px
    text-overflow ellipsis
    white-space nowrap

  span
    flex 0 0 auto
    color var(--workbench-muted, #667085)
    font-size 12px

.cn-ai-empty-state
  width 100%
  padding 18px 4px 12px
  color #344054

  .cn-ai-empty-copy
    display block

    strong,
    span
      display block

    strong
      color #1f2937
      font-size 15px

    span
      max-width 560px
      margin-top 5px
      color #667085
      font-size 12px
      line-height 18px

.cn-ai-agent-status
  display flex
  align-items center
  gap 8px
  margin 0 4px 8px
  padding 8px 10px
  border 1px solid #d8e0ea
  border-radius 7px
  background #f8fafc

.cn-ai-agent-status-main
  min-width 0
  flex 1 1 auto

.cn-ai-agent-pending-command
  display block
  margin-top 5px
  padding 4px 6px
  overflow hidden
  border 1px solid #f3d08a
  border-radius 4px
  background #fff
  color #874d00
  font-size 12px
  line-height 16px
  text-overflow ellipsis
  white-space nowrap

.cn-ai-agent-status-actions
  display flex
  flex 0 0 auto
  align-items center
  gap 6px

.cn-ai-agent-stop-button
  display inline-flex
  align-items center
  justify-content center
  flex 0 0 auto
  min-width 48px
  height 28px
  padding 0 10px
  border 1px solid #f0a7a0
  border-radius 6px
  background #fff7f5
  color #b42318
  font-size 12px
  line-height 1
  cursor pointer

  &:hover
    border-color #d92d20
    background #fef0ef

  &:focus-visible
    outline 2px solid #f97066
    outline-offset 1px

.cn-ai-agent-status
  > div
    min-width 0

  strong,
  span
    display block

  strong
    color #344054
    font-size 12px

  span
    margin-top 2px
    overflow hidden
    color #667085
    font-size 11px
    text-overflow ellipsis
    white-space nowrap

.cn-ai-agent-status-dot
  width 8px
  height 8px
  flex 0 0 8px
  border-radius 50%
  background #98a2b3

.cn-ai-agent-status.status-running
  border-color #b8d8ff
  background #f5f8ff

  .cn-ai-agent-status-dot
    background #1677ff
    box-shadow 0 0 0 3px rgba(22, 119, 255, .12)

.cn-ai-agent-status.status-pending
  border-color #fedf89
  background #fffbeb

  .cn-ai-agent-status-dot
    background #f79009

.cn-ai-agent-status.status-error
  border-color #fecdca
  background #fff6f5

  .cn-ai-agent-status-dot
    background #d92d20

.cn-ai-agent-status.status-done
  border-color #abefc6
  background #f6fef9

  .cn-ai-agent-status-dot
    background #12b76a

.cn-ai-config-notice
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 0 12px 8px
  padding 10px
  border 1px solid #fedf89
  border-radius 8px
  background #fffbeb

  div
    min-width 0

  strong,
  span
    display block

  strong
    color #93370d
    font-size 13px

  span
    margin-top 3px
    color #b54708
    font-size 12px
    line-height 18px

  button
    flex 0 0 auto
    height 30px
    padding 0 12px
    border 1px solid #f79009
    border-radius 6px
    background #fff7ed
    color #b54708
    cursor pointer

    &:hover
      background #ffedd5

.chat-history-item
  position relative
  > .ai-stop-icon-square
    position absolute
    bottom 8px
    right 8px
    z-index 10
  .code-block
    border 1px dashed var(--main-darker)
    padding 5px
    border-radius 3px
    pre
      margin-bottom 0
    // .code-block-actions
    //   display block
    // &:hover
    //   .code-block-actions
    //     display block

.ai-stream-output
  // 2026-07-20 coder(lq): Keep AI chat with a single scroll owner, otherwise long replies create nested scrollbars in the right sidebar.
  max-height none
  overflow visible

.ai-chat-input
  position relative
  margin-top 10px
  flex 0 0 auto

  .ant-input
    padding-bottom 82px

  .ai-chat-textarea::placeholder
    // 2026-07-20 coder(lq): The AI input sits on a large white surface; default placeholder contrast is too low for quick scanning.
    color #7b8798 !important
    opacity 1

  .ai-chat-terminals
    position absolute
    bottom 8px
    left 10px
    right 10px
    background transparent
    z-index 1
    gap 6px
    font-size 14px

.cn-ai-control-row
  display flex
  align-items center
  justify-content space-between
  gap 8px
  min-width 0

.cn-ai-target-select
  min-width 0
  flex 1 1 auto
  display flex
  align-items center
  gap 6px
  overflow hidden

  .batch-tab-select-trigger
    max-width 100%
    min-height 26px
    padding 0
    overflow hidden
    white-space nowrap
    text-overflow ellipsis
    font-size 13px

.cn-ai-agent-target
  display inline-flex
  align-items center
  min-width 0
  max-width 100%
  height 26px
  padding 0 8px
  border-radius 6px
  background #f6f9fd
  color #344054
  font-size 13px
  font-weight 600
  line-height 1
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.cn-ai-action-icons
  flex 0 0 auto
  display inline-flex
  align-items center
  justify-content flex-end
  gap 6px

  > span
    margin 0
    width 28px
    height 28px
    display inline-flex
    align-items center
    justify-content center
    border-radius 7px
    color #344054
    font-size 17px
    line-height 1

    &:hover
      background #f5f8ff
      color #1677ff

.cn-ai-icon-button,
.cn-ai-send-button
  width 28px
  height 28px
  display inline-flex
  align-items center
  justify-content center
  flex 0 0 28px
  margin 0
  border-radius 7px
  border 0
  padding 0
  background transparent
  color #344054
  font-size 17px
  font-family inherit
  line-height 1
  appearance none

  &:hover
    background #f5f8ff
    color #1677ff

  &:focus-visible
    outline 2px solid #8db8f5
    outline-offset 1px

.cn-ai-icon-button.is-active
  background #eef5ff
  color #1677ff

.cn-ai-new-session-indicator
  min-width 0
  overflow hidden
  color #1677ff
  font-size 11px
  text-overflow ellipsis
  white-space nowrap

.cn-ai-send-button
  color #1f2937
  font-size 19px
  margin-left 6px

  &.disabled
    color #b8c2d2
    cursor not-allowed

.code-block
  width 100%

  .code-action-icon
    border 0
    padding 2px
    background transparent
    color inherit
    cursor pointer

    &:hover,
    &:focus-visible
      color #1677ff

    &:focus-visible
      outline 2px solid #8db8f5
      outline-offset 1px

  pre
    white-space pre-wrap
    word-wrap break-word
    overflow-x auto
    max-width 100%
  code
    white-space pre-wrap
    word-break break-all

.send-to-ai-icon.disabled
  opacity 0.4
  cursor not-allowed

.ai-stop-icon-square
  width 20px
  height 20px
  border-radius 2px
  border 0
  padding 0
  background transparent
  display flex
  align-items center
  justify-content center
  font-size 10px
  cursor pointer

  &:focus-visible
    outline 2px solid #8db8f5
    outline-offset 1px

.ai-history-item-title
  display flex
  align-items center

  .ai-history-item-prompt
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  .ai-history-inline-actions
    display inline-flex
    align-items center
    gap 8px
    margin-left auto
    flex 0 0 auto

  .ai-history-toggle,
  .ai-history-meta-action
    border 0
    padding 0
    background transparent
    color inherit
    cursor pointer

    &:focus-visible
      outline 2px solid #8db8f5
      outline-offset 1px

  .ai-stop-icon-square
    margin-left auto

.ai-history-meta-action
  font-size 14px

  &:hover
    color #1677ff

.agent-tool-calls
  margin 8px 0

.ai-execution-details
  margin 5px 0 7px

.ai-execution-details-body
  margin-top 4px
  padding 8px 10px
  border-left 2px solid $ai-border-soft
  color $ai-muted-strong

.ai-execution-waiting
  color $ai-muted
  font-size 12px
  line-height 1.6

.ai-execution-details-toggle
  display inline-flex
  align-items center
  gap 5px
  min-height 24px
  padding 2px 5px
  border 0
  border-radius 4px
  background transparent
  color $ai-muted
  font-family inherit
  font-size 11px
  cursor pointer

  &:hover
    background $ai-primary-tint
    color $ai-primary

  &:focus-visible
    outline 2px solid $ai-primary-border
    outline-offset 1px

  em
    padding 0 4px
    border-radius 8px
    background $ai-panel-muted
    color $ai-muted
    font-size 10px
    font-style normal

.ai-solution-record-actions
  display flex
  justify-content flex-end
  margin 6px 0 2px

  button
    height 28px
    display inline-flex
    align-items center
    gap 5px
    padding 0 10px
    border 1px solid #cfd8e6
    border-radius 6px
    background #fff
    color #344054
    font-size 12px
    cursor pointer

    &:hover
      border-color #1677ff
      color #1677ff
      background #f5f8ff

    &:disabled
      opacity .55
      cursor not-allowed

.agent-tool-call-card
  border 1px solid var(--main-darker)
  border-radius 4px
  margin-bottom 6px
  font-size 13px

.agent-tool-header
  display flex
  align-items center
  padding 6px 8px
  gap 6px

.agent-tool-toggle
  min-width 0
  flex 1 1 auto
  display flex
  align-items center
  gap 6px
  padding 0
  border 0
  background transparent
  color inherit
  font inherit
  text-align left
  cursor pointer

  &:focus-visible
    outline 2px solid #8db8f5
    outline-offset 1px

.agent-tool-name
  font-weight 500
  flex 0 0 auto

.agent-tool-command-kind
  flex 0 0 auto
  color #98a2b3
  font-size 11px
  letter-spacing .04em
  text-transform uppercase

.agent-tool-command-preview
  min-width 0
  max-width 42%
  padding 1px 6px
  border 1px solid #d8e0ea
  border-radius 4px
  background #f8fafc
  color #344054
  font-size 12px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.agent-tool-tag
  margin-left auto

.agent-tool-risk-tag
  margin-left 4px

.agent-tool-status-running
  color #1890ff
  animation spin 1s linear infinite

.agent-tool-status-completed
  color #52c41a

.agent-tool-status-pending
  color #d48806

.agent-tool-status-skipped
  color #98a2b3

.agent-tool-status-error
  color #ff4d4f

.agent-tool-confirm-button
  height 24px
  padding 0 8px
  border 1px solid #f0b95a
  border-radius 6px
  background #fff8e6
  color #ad6800
  display inline-flex
  align-items center
  gap 4px
  cursor pointer
  font-size 12px
  flex 0 0 auto

  &:hover
    border-color #d48806
    background #fff1c2
    color #874d00

.agent-tool-replay-button
  height 24px
  padding 0 8px
  border 1px solid #b8cdf0
  border-radius 6px
  background #f5f8ff
  color #1677ff
  display inline-flex
  align-items center
  gap 4px
  cursor pointer
  font-size 12px
  flex 0 0 auto

  &:hover:not(:disabled)
    border-color #1677ff
    background #eaf2ff

  &:focus-visible
    outline 2px solid #8db8f5
    outline-offset 1px

  &:disabled
    opacity .45
    cursor not-allowed

.agent-command-replay-confirm
  p
    margin 0 0 10px

  code
    display block
    max-height 160px
    padding 8px 10px
    overflow auto
    border 1px solid #e4e7ec
    border-radius 6px
    background #f8fafc
    color #344054
    white-space pre-wrap
    word-break break-word

.agent-tool-skip-button
  height 24px
  padding 0 8px
  border 1px solid #d8e0ea
  border-radius 6px
  background #fff
  color #667085
  display inline-flex
  align-items center
  gap 4px
  cursor pointer
  font-size 12px
  flex 0 0 auto

  &:hover
    border-color #98a2b3
    background #f8fafc
    color #344054

.agent-tool-detail
  padding 0 8px 8px
  border-top 1px solid var(--main-darker)

.agent-tool-args
  margin-top 6px

.agent-tool-result
  margin-top 6px

.agent-tool-label
  font-weight 500
  margin-bottom 4px
  font-size 12px
  color var(--text-color-2)

.agent-tool-pre
  background var(--main-dark)
  padding 6px 8px
  border-radius 3px
  font-size 12px
  max-height 200px
  overflow-y auto
  white-space pre-wrap
  word-break break-all
  margin-bottom 0

.agent-tool-running
  border-color #1890ff

.agent-tool-completed
  border-color #52c41a

.agent-tool-pending_confirm
  border-color #d48806

.agent-tool-skipped
  border-color #98a2b3

.agent-tool-error
  border-color #ff4d4f

@media (max-width: 520px)
  .agent-tool-command-preview
    max-width 32%

  .agent-tool-confirm-button span
    display none

@keyframes spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

// 2026-07-02 coder(lq): AI panels are normal assistant pages; cards, code blocks, and tool calls should follow the light workbench system.
.ai-chat-container,
.ai-history-wrap,
.ai-stream-output
  background #fff !important
  color #1f2937 !important

.chat-history-item:not(.ai-chat-turn),
.agent-tool-call-card
  background #fff !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  color #344054 !important

.chat-history-item .code-block,
.agent-tool-detail
  border-color #d8e0ea !important

.agent-tool-pre
  background #f8fafc !important
  color #1f2937 !important
  border 1px solid #e4eaf2

.agent-tool-label
  color #667085 !important

.ai-chat-input .ant-input
  background #fff !important
  border-color #cfd8e6 !important
  color #1f2937 !important

// 2026-07-04 coder(lq): AI right panel is rendered inside terminal chrome, so explicitly reset AntD assistant widgets to the light ops palette.
.ai-chat-container
  .ant-alert
    border-color #b8d8ff !important
    border-radius 8px !important
    background #f5f8ff !important
    color #344054 !important

  .ant-alert-message,
  .ant-alert-description
    color #344054 !important

  .ant-segmented
    background #f1f5f9 !important
    color #667085 !important

  .ant-segmented-item
    color #667085 !important

  .ant-segmented-item-selected
    background #fff !important
    color #1677ff !important
    box-shadow 0 1px 3px rgba(15, 23, 42, .10) !important

  .ant-input,
  textarea.ant-input,
  .ant-input-affix-wrapper
    background #fff !important
    border-color #cfd8e6 !important
    color #1f2937 !important

  .ant-input-affix-wrapper .ant-input,
  .ant-input-affix-wrapper .ant-input:focus
    border 0 !important
    box-shadow none !important
    outline none !important
    background transparent !important

// 2026-08-30 coder(lq): Rebalance the AI Shell around task status and a compact composer instead of stacked form cards.
.ai-chat-container
  background var(--workbench-bg, #f4f7fb) !important
  color var(--workbench-text, #1f2937) !important

  .ai-chat-history
    padding 0 12px 8px
    background var(--workbench-bg, #f4f7fb) !important

  .cn-ai-chat-intro
    align-items flex-start
    margin 0 0 8px
    padding 12px 14px
    border 1px solid var(--workbench-border, #dbe3ef)
    border-left 3px solid var(--workbench-primary, #1769e0)
    border-radius 8px
    background var(--workbench-panel, #fff)
