const fs = require('fs')
const os = require('os')
const path = require('path')
const { spawnSync } = require('child_process')

const root = path.resolve(__dirname, '../..')
const iconDir = path.join(root, 'build/icons')
const svgPath = path.join(iconDir, 'yunduo.svg')
const sizes = [16, 32, 48, 64, 128, 256, 512, 1024]

function run (command, args) {
  const result = spawnSync(command, args, {
    cwd: root,
    stdio: 'inherit'
  })
  if (result.status !== 0) {
    throw new Error(`${command} ${args.join(' ')} failed`)
  }
}

function writeIco (pngPaths, output) {
  const images = pngPaths.map(file => {
    const size = Number(path.basename(file).match(/yunduo-(\d+)\.png/)[1])
    return {
      size,
      data: fs.readFileSync(file)
    }
  })
  const headerSize = 6
  const entrySize = 16
  let offset = headerSize + images.length * entrySize
  const chunks = []
  const header = Buffer.alloc(headerSize)
  header.writeUInt16LE(0, 0)
  header.writeUInt16LE(1, 2)
  header.writeUInt16LE(images.length, 4)
  chunks.push(header)
  for (const image of images) {
    const entry = Buffer.alloc(entrySize)
    entry.writeUInt8(image.size >= 256 ? 0 : image.size, 0)
    entry.writeUInt8(image.size >= 256 ? 0 : image.size, 1)
    entry.writeUInt8(0, 2)
    entry.writeUInt8(0, 3)
    entry.writeUInt16LE(1, 4)
    entry.writeUInt16LE(32, 6)
    entry.writeUInt32LE(image.data.length, 8)
    entry.writeUInt32LE(offset, 12)
    chunks.push(entry)
    offset += image.data.length
  }
  chunks.push(...images.map(image => image.data))
  fs.writeFileSync(output, Buffer.concat(chunks))
}

function renderPngs () {
  const renderer = path.join(os.tmpdir(), `yunduo-icon-renderer-${process.pid}.js`)
  fs.writeFileSync(renderer, `
const fs = require('fs')
const os = require('os')
const path = require('path')
const { pathToFileURL } = require('url')
const { app, BrowserWindow, nativeImage } = require('electron')

const [svgPath, iconDir, sizesArg] = process.argv.slice(2)
const sizes = sizesArg.split(',').map(Number)
const baseSize = Math.max(...sizes)

app.disableHardwareAcceleration()
app.whenReady().then(async () => {
  const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'yunduo-icon-'))
  const htmlPath = path.join(tempDir, 'icon.html')
  const svgUrl = pathToFileURL(svgPath).href
  const html = '<!doctype html><html><body style="margin:0;width:' + baseSize + 'px;height:' + baseSize + 'px;overflow:hidden;background:transparent"><img src="' + svgUrl + '" style="display:block;width:' + baseSize + 'px;height:' + baseSize + 'px"></body></html>'
  fs.writeFileSync(htmlPath, html)
  const win = new BrowserWindow({
    width: baseSize,
    height: baseSize,
    show: false,
    frame: false,
    transparent: true,
    resizable: false,
    webPreferences: {
      offscreen: true,
      backgroundThrottling: false
    }
  })
  await win.loadFile(htmlPath)
  await new Promise(resolve => setTimeout(resolve, 120))
  const image = await win.webContents.capturePage({
    x: 0,
    y: 0,
    width: baseSize,
    height: baseSize
  })
  const png = image.toPNG()
  for (const size of sizes) {
    const output = nativeImage.createFromBuffer(png).resize({
      width: size,
      height: size,
      quality: 'best'
    }).toPNG()
    fs.writeFileSync(path.join(iconDir, 'yunduo-' + size + '.png'), output)
  }
  win.destroy()
  fs.rmSync(tempDir, { recursive: true, force: true })
  app.quit()
}).catch(error => {
  console.error(error)
  app.exit(1)
})
`)
  try {
    run(require('electron'), [renderer, svgPath, iconDir, sizes.join(',')])
  } finally {
    fs.rmSync(renderer, { force: true })
  }
}

function copyPngs () {
  const linuxDir = path.join(iconDir, 'linux')
  const iconsetDir = path.join(iconDir, 'yunduo.iconset')
  fs.mkdirSync(linuxDir, { recursive: true })
  fs.mkdirSync(iconsetDir, { recursive: true })
  for (const size of sizes) {
    fs.copyFileSync(
      path.join(iconDir, `yunduo-${size}.png`),
      path.join(linuxDir, `${size}x${size}.png`)
    )
  }
  const iconsetMap = [
    ['icon_16x16.png', 16],
    ['icon_16x16@2x.png', 32],
    ['icon_32x32.png', 32],
    ['icon_32x32@2x.png', 64],
    ['icon_128x128.png', 128],
    ['icon_128x128@2x.png', 256],
    ['icon_256x256.png', 256],
    ['icon_256x256@2x.png', 512],
    ['icon_512x512.png', 512],
    ['icon_512x512@2x.png', 1024]
  ]
  for (const [file, size] of iconsetMap) {
    fs.copyFileSync(
      path.join(iconDir, `yunduo-${size}.png`),
      path.join(iconsetDir, file)
    )
  }
}

function readPngSize (file) {
  const data = fs.readFileSync(file)
  return {
    width: data.readUInt32BE(16),
    height: data.readUInt32BE(20)
  }
}

function validatePngs () {
  for (const size of sizes) {
    const file = path.join(iconDir, `yunduo-${size}.png`)
    const dimensions = readPngSize(file)
    if (dimensions.width !== size || dimensions.height !== size) {
      throw new Error(`${file} should be ${size}x${size}, got ${dimensions.width}x${dimensions.height}`)
    }
  }
}

renderPngs()
validatePngs()
copyPngs()
run('iconutil', ['-c', 'icns', '-o', path.join(iconDir, 'yunduo.icns'), path.join(iconDir, 'yunduo.iconset')])
writeIco(
  [16, 32, 48, 256].map(size => path.join(iconDir, `yunduo-${size}.png`)),
  path.join(iconDir, 'yunduo.ico')
)
