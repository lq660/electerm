
.tabs
  position relative
  height 36px
  overflow hidden
  background var(--main-dark)
  z-index 12
  ::-webkit-scrollbar
    width 0
    display none
.not-system-ui.is-mac .layout-item.v1 .tabs-inner
  margin-left 42px
.not-system-ui.is-mac.not-webapp .layout-item.v1
  .tabs-inner
    // 2026-07-04 coder(lq): Keep only the native traffic-light drag clearance; the old wide gap looked like an unnamed, unclickable first tab.
    margin-left 28px
.not-system-ui.is-mac.not-webapp.pinned .layout-item.v1
  .tabs-inner
    margin-left 0
.not-system-ui.not-mac.not-webapp
  .tabs-extra
    right 96px
.tabs-inner
  position relative
  z-index 2
  padding 0
  margin-top 0
  display inline-block
  height 36px
  overflow-x scroll
  overflow-y hidden

.tabs-wrapper
  z-index 3
.tab
  display inline-block
  vertical-align middle
  cursor pointer
  position relative
  padding 0 14px
  min-width 100px
  max-width 200px
  line-height 36px
  margin 0 1px 0 0
  border-radius 3px 3px 0 0
  background var(--main-dark)
  text-align center
  color var(--text-dark)
  &.tab-last
    margin-right 5px
  .tab-close
    display none
  &.active
    color var(--text)
    background var(--main)
  &.active-all
    font-weight bold
    .tab-count
      border-radius 15px
      font-weight bold
  &:hover
    .tab-close
      display block
  &.dragover-tab::after
    position absolute
    content ''
    left -2px
    top 0
    width 1px
    border 1px dashed var(--text-dark)
    height 36px
@keyframes blink
  0%
    background-color #e0e0e0
  50%
    background-color #ffffff
  100%
    background-color #e0e0e0

.tab-terminal-feed
.tab-traffic
.tab-status
  position absolute
  left 2px
  top 2px
  width 5px
  height 5px
  border-radius 5px
  background-color var(--text-dark)
  &.success
    background-color var(--success)
  &.error
    background-color var(--error)
  &.processing
    background-color var(--primary)
.tab-traffic
  left 10px
  width 5px
  border-radius 0
  background-color var(--success)
  animation blink 2s infinite
.tab-terminal-feed
  width 12px
  height 12px
  border-radius 0
  color var(--success)
  font-size 12px
  left 2px
  top 24px
  background none
  background-color transparent !important
  animation blink 2s infinite
  &.password
    color var(--warn)
.tab-close
  position absolute
  right 5px
  cursor pointer
  top 50%
  background var(--main)
  margin-top -8px
  border-radius 100%
  color var(--text)
  height 16px
  width 16px
  text-align center
  line-height 16px
  font-size 10px
  &:hover
    background var(--error)

.tabs-add-btn
  display inline-block
  vertical-align middle
  margin 0 3px 0 3px
  &.empty
    font-size 20px
    margin-left 20px
    margin-top 10px
  &:hover
    color var(--text-light)
.tabs-extra
  position absolute
  height 40px
  top 0
  right 0
  line-height 40px
  z-index 20

  .tabs-dd-icon
    font-size 12px
  .tabs-add-btn
    margin-top 0

.window-controls
  position absolute
  right 0
  top 0
  z-index 900
  border-radius 0 0 3px 3px
  padding 0
  background var(--main)
  -webkit-app-region no-drag

.window-control-box
  display inline-block
  padding 5px 10px
  color var(--text)
  &:hover
    color var(--primary)
    cursor pointer
    .icon-maximize
      border-color var(--primary)
.icon-maximize
  width 10px
  height 7px
  border 1px solid var(--text)
  cursor pointer
  &.is-max
    height 6px
    position relative
    &:before
      position absolute
      content ''
      left -3px
      top 3px
      width 8px
      height 4px
      border 1px solid text
      border-top none
      border-right none

.control-icon:hover
  color var(--text-light)
.tab-scroll-icon
  color var(--text-dark)
  &:hover
    color var(--text)

.window-controls
  .window-control-minimize
  .window-control-maximize
    &:hover
      background var(--main-dark)
  .window-control-close:hover
    background var(--error)

.system-ui
  .window-controls
    display none
.tab-title-tag
  margin-right 5px
  font-size 14px

.tab-count
  display inline-flex !important
  align-items center
  justify-content center
  flex 0 0 auto
  min-width 24px
  height 24px
  padding 0 7px
  border-radius 8px
  box-sizing border-box
  line-height 1
  font-size 13px

.ssh-tunnel-list-wrapper
  max-height 300px
  overflow-y auto

// Layout and Workspace dropdown styles
.layout-workspace-dropdown
  background var(--main)
  border-radius 4px
  box-shadow 0 2px 8px rgba(0, 0, 0, 0.15)
  min-width 200px
  padding 8px
  .ant-tabs-nav
    margin-bottom 8px

.layout-menu-content
  max-height 300px
  overflow-y auto

.layout-menu-item
  padding 6px 12px
  cursor pointer
  border-radius 4px
  display flex
  align-items center
  gap 8px
  color var(--text)
  &:hover
    background var(--main-dark)
  &.active
    background var(--primary)
    color #fff

.workspace-menu-content
  max-height 300px
  overflow-y auto

.workspace-save-btn
  margin-bottom 8px

.workspace-list
  display flex
  flex-direction column
  gap 4px

.workspace-item
  padding 6px 12px
  cursor pointer
  border-radius 4px
  display flex
  align-items center
  justify-content space-between
  color var(--text)
  &:hover
    background var(--main-dark)
  .workspace-delete-icon
    opacity 0
    color var(--text-dark)
    &:hover
      color var(--error)
  &:hover .workspace-delete-icon
    opacity 1

.workspace-name
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.not-webapp.not-win
  .tab
  .tabs-add-btn
  .window-control-box
  .tab-close
  .tab-reload
  .tabs-extra
    -webkit-app-region no-drag

// 2026-07-02 coder(lq): Dropdown pages opened from the tab bar use the light workbench menu style; session tabs themselves keep contrast for terminal focus.
.layout-workspace-dropdown
  background #fff !important
  color #1f2937 !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  box-shadow 0 16px 40px rgba(15, 23, 42, .14) !important

.layout-menu-item,
.workspace-item
  color #344054 !important
  border-radius 6px !important
  &:hover,
  &.active
    background #eef5ff !important
    color #1677ff !important

.workspace-delete-icon
  color #667085 !important
  &:hover
    color #f04438 !important

// 2026-07-03 coder(lq): Light outer tab/title frame for the China workbench. Terminal canvases keep their dark theme; the app chrome should not.
#container
  .tabs
    height 40px !important
    background #f8fbff !important
    border-bottom 1px solid #cbd8ea !important
    box-shadow 0 6px 16px rgba(15, 23, 42, .06) !important

  .tabs-inner,
  .tabs-wrapper
    height 40px !important
    background #f8fbff !important

  .tab
    // 2026-07-22 coder(lq): Outer connection tabs are the primary navigation; keep them visually stronger than the inner terminal/file tabs.
    display inline-flex !important
    align-items center !important
    justify-content center !important
    gap 6px !important
    height 37px !important
    line-height 1 !important
    margin 3px 3px 0 0 !important
    border 1px solid transparent !important
    border-bottom 0 !important
    border-radius 6px 6px 0 0 !important
    background transparent !important
    color #52647a !important
    font-size 14px !important

    &:hover
      background #edf5ff !important
      border-color #c8dcf8 !important
      color #1677ff !important

    &.active
      background #fff !important
      border-color #9ec5ff !important
      color #1769e0 !important
      font-weight 700 !important
      box-shadow 0 -1px 0 #fff inset, 0 4px 12px rgba(23, 105, 224, .10) !important

    &.home-tab
      min-width 76px
      max-width 92px
      padding 0 12px
      color #344054 !important

      &:before
        content '⌂'
        display inline-flex
        align-items center
        justify-content center
        width 14px
        height 14px
        margin 0
        color #1677ff
        font-size 13px
        line-height 1

      &.active
        background #fff !important
        border-color #9ec5ff !important
        color #1769e0 !important

    .tab-title
      min-width 0
      line-height 1

      &.elli
        display flex
        align-items center
        justify-content center
        max-width 100%

    .tab-title-content
      display inline-flex
      align-items center
      min-width 0
      max-width 100%
      line-height 1

    .tab-title-text
      display block
      min-width 0
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
      line-height 1

  .tab-close
    background #eef2f7 !important
    color #667085 !important

    &:hover
      background #f04438 !important
      color #fff !important

  .tabs-add-btn,
  .tabs-extra,
  .tab-scroll-icon,
  .tabs-dd-icon
    color #667085 !important

    &:hover
      color #1677ff !important

  .tabs-add-btn
    display inline-flex !important
    align-items center !important
    justify-content center !important
    width 40px
    height 40px
    margin 0 3px !important
    line-height 1 !important

    &.empty
      margin 0 3px !important

  .tabs-extra
    display inline-flex !important
    align-items center !important
    justify-content center !important
    height 40px !important
    line-height 1 !important

  .tab-scroll-icon,
  .tabs-dd-icon
    display inline-flex !important
    align-items center !important
    justify-content center !important
    line-height 1 !important

  .window-controls
    background #fff !important
    border-left 1px solid #d8e0ea !important
    border-bottom 1px solid #d8e0ea !important
    box-shadow none !important

  .window-control-box
    color #667085 !important

    &:hover
      background #f5f8ff !important
      color #1677ff !important

  .window-control-close:hover
    background #f04438 !important
    color #fff !important

  .window-control-minimize:hover,
  .window-control-maximize:hover
    background #f5f8ff !important

  .icon-maximize
    border-color #667085 !important

  .window-control-box:hover .icon-maximize
    border-color #1677ff !important
