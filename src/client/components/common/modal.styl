.custom-modal-wrap
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  overflow auto
  outline 0

.custom-modal-mask
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  background rgba(0, 0, 0, 0.45)

.custom-modal-container
  position relative
  display flex
  align-items flex-start
  justify-content center
  min-height 100%
  padding 24px
  word-break break-word

.custom-modal-content
  position relative
  background var(--main)
  border-radius 8px
  box-shadow 0 6px 16px 0 rgba(0, 0, 0, 0.08), 0 3px 6px -4px rgba(0, 0, 0, 0.12), 0 9px 28px 8px rgba(0, 0, 0, 0.05)
  margin-top 50px
  max-width calc(100vw - 48px)

.custom-modal-header
  display flex
  align-items center
  justify-content space-between
  padding 16px 24px
  border-bottom 1px solid var(--main-darker)

.custom-modal-title
  font-size 16px
  font-weight 600
  color var(--text)
  line-height 1.5
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.custom-modal-close
  display flex
  align-items center
  justify-content center
  width 32px
  height 32px
  padding 0
  margin-left 8px
  background transparent
  border none
  border-radius 4px
  color var(--text)
  cursor pointer
  transition background-color 0.2s
  &:hover
    background var(--main-darker)
  &:focus
    outline none

.custom-modal-body
  padding 0 24px 24px 24px
  color var(--text)

.custom-modal-footer
  padding 12px 24px
  border-top 1px solid var(--main-darker)
  text-align right

.custom-modal-footer-buttons
  display flex
  justify-content flex-end
  gap 8px

.custom-modal-ok-btn,
.custom-modal-cancel-btn
  padding 6px 16px
  border none
  border-radius 4px
  cursor pointer
  font-size 14px
  transition background-color 0.2s

.custom-modal-ok-btn
  background var(--primary)
  color var(--primary-contrast)

.custom-modal-cancel-btn
  background var(--main)
  color var(--text)

// 2026-07-02 coder(lq): Keep every reusable modal on the same light China ops palette as the redesigned workbench pages.
.custom-modal-mask
  background rgba(15, 23, 42, .16) !important

.custom-modal-content
  background #fff !important
  color #1f2937 !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  box-shadow 0 18px 48px rgba(15, 23, 42, .18) !important

.custom-modal-header
  background #fbfdff !important
  border-bottom 1px solid #d8e0ea !important

.custom-modal-title
  color #1f2937 !important
  font-size 15px !important

.custom-modal-close
  color #667085 !important
  &:hover
    color #1677ff !important
    background #eef5ff !important

.custom-modal-body
  color #344054 !important
  background #fff !important

.custom-modal-footer
  background #fbfdff !important
  border-top 1px solid #d8e0ea !important

.custom-modal-ok-btn
  background #1677ff !important
  color #fff !important

.custom-modal-cancel-btn
  background #fff !important
  color #344054 !important
  border 1px solid #d8e0ea !important

// 2026-07-04 coder(lq): AntD controls inside custom modals need explicit light states because file permission dialogs use dashed buttons.
.custom-modal-content
  .ant-btn
    border-radius 6px !important
    box-shadow none !important

  .ant-btn-primary
    background #1677ff !important
    border-color #1677ff !important
    color #fff !important

  .ant-btn-dashed,
  .ant-btn-default
    background #fff !important
    border-color #cfd8e6 !important
    color #344054 !important

    &:hover
      border-color #1677ff !important
      color #1677ff !important

  // 2026-07-04 coder(lq): Modal form controls are rendered outside the main workbench skin, so normalize AntD fields here too.
  .ant-input,
  textarea.ant-input,
  .ant-input-affix-wrapper,
  .ant-select,
  .ant-select-selector,
  .ant-input-number,
  .ant-auto-complete .ant-input
    background #fff !important
    border-color #cfd8e6 !important
    border-radius 6px !important
    color #1f2937 !important
    box-shadow none !important

  .ant-input-affix-wrapper .ant-input,
  .ant-auto-complete .ant-input
    border 0 !important
    background transparent !important

  .ant-input::placeholder,
  textarea.ant-input::placeholder,
  .ant-select-selection-placeholder
    color #98a2b3 !important

  .ant-input:focus,
  textarea.ant-input:focus,
  .ant-input-affix-wrapper-focused,
  .ant-select-focused .ant-select-selector,
  .ant-input-number-focused
    border-color #1677ff !important
    box-shadow 0 0 0 2px rgba(22, 119, 255, .08) !important

  .ant-input-affix-wrapper .ant-input,
  .ant-input-affix-wrapper .ant-input:focus
    border 0 !important
    box-shadow none !important
    background transparent !important

  .ant-form-item-label > label,
  .ant-form-item,
  .ant-select-selection-item,
  .ant-select-arrow,
  .ant-input-suffix,
  .ant-input-prefix
    color #344054 !important

  // 2026-07-20 coder(lq): Password prompt options should follow the light blue ops palette instead of inheriting dark checkbox colors.
  .ant-checkbox-wrapper
    color #344054 !important

    &:hover
      color #1677ff !important

      .ant-checkbox-inner
        border-color #1677ff !important

  .ant-checkbox-inner
    background #fff !important
    border-color #cfd8e6 !important

  .ant-checkbox-checked .ant-checkbox-inner
    background #1677ff !important
    border-color #1677ff !important

  .ant-checkbox-disabled .ant-checkbox-inner
    background #f3f7fc !important
    border-color #d8e0ea !important

  .ant-checkbox-disabled + span
    color #667085 !important

  .ant-alert
    border-color #b8d8ff !important
    border-radius 8px !important
    background #f5f8ff !important
    color #344054 !important

  .ant-alert-message,
  .ant-alert-description
    color #344054 !important

  .ant-segmented
    background #f1f5f9 !important
    color #667085 !important

  .ant-segmented-item
    color #667085 !important

  .ant-segmented-item-selected
    background #fff !important
    color #1677ff !important
    box-shadow 0 1px 3px rgba(15, 23, 42, .10) !important
