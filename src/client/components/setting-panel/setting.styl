.pd2b.bg-img-setting
  display inline-block
  padding 0
  margin 5px 5px 0 0
.font-sel
  min-width 200px
.setting-wrap .app-drag
  position fixed
  top 0
  left 43px
  height 60px
  right 0
  z-index 888

// 2026-07-03 coder(lq): Setting pages can load after the global skin and inherit dark terminal theme variables, so force ordinary form selectors back to the light workbench palette.
.setting-wrap
  .ant-select,
  .ant-select-single,
  .ant-select-multiple,
  .ant-auto-complete
    color #1f2937 !important

  .ant-select-selector,
  .ant-select:not(.ant-select-customize-input) .ant-select-selector,
  .ant-select-single:not(.ant-select-customize-input) .ant-select-selector,
  .ant-select-multiple .ant-select-selector
    min-height 34px !important
    background #fff !important
    border 1px solid #cfd8e6 !important
    border-radius 6px !important
    color #1f2937 !important
    box-shadow none !important

  .ant-select-selection-item,
  .ant-select-selection-placeholder,
  .ant-select-selection-search,
  .ant-select-selection-search-input,
  .ant-select-selection-overflow,
  .ant-select-selection-overflow-item,
  .ant-select-selection-item-content
    background transparent !important
    color #1f2937 !important

  .ant-select-selection-placeholder
    color #98a2b3 !important

  .ant-select-arrow,
  .ant-select-clear,
  .ant-select-selection-item-remove
    color #667085 !important

  .ant-select-focused .ant-select-selector,
  .ant-select-open .ant-select-selector
    border-color #1677ff !important
    box-shadow 0 0 0 2px rgba(22, 119, 255, .08) !important

.subscription-settings
  display flex
  flex-direction column
  gap 12px

.subscription-current-card
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 14px
  border 1px solid #dbe3ef
  border-radius 8px
  background #f8fbff

  div
    display flex
    flex-direction column
    gap 4px

  span
    color #667085
    font-size 12px

  strong
    color #1f2937
    font-size 22px

  em
    color #667085
    font-style normal
    font-size 12px

.subscription-plan-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 12px

.subscription-plan-card
  display flex
  flex-direction column
  min-height 300px
  padding 14px
  border 1px solid #dbe3ef
  border-radius 8px
  background #fff

  &.active
    border-color #1677ff
    box-shadow 0 8px 24px rgba(22, 119, 255, .1)

  p
    margin 0

  ul
    flex 1
    margin 12px 0
    padding 0
    list-style none

  li
    display flex
    align-items flex-start
    gap 8px
    margin-bottom 10px
    color #344054
    line-height 1.5

    .anticon
      color #1677ff
      margin-top 3px

.subscription-plan-head
  display flex
  justify-content space-between
  gap 8px

  div
    display flex
    flex-direction column
    gap 5px

  strong
    color #1f2937
    font-size 18px

  span
    color #667085
    font-size 12px

.subscription-plan-highlight
  margin-top 12px !important
  color #1f2937
  font-weight 600
  line-height 1.45

.subscription-plan-target
  margin-top 6px !important
  color #667085
  font-size 12px
  line-height 1.5

.subscription-plan-limits
  display flex
  flex-direction column
  gap 6px
  margin 0 0 12px
  padding-top 10px
  border-top 1px solid #edf1f7

  span
    color #667085
    font-size 12px
    line-height 1.45

.subscription-compare
  overflow hidden
  border 1px solid #dbe3ef
  border-radius 8px
  background #fff

.subscription-compare-head,
.subscription-compare-row
  display grid
  grid-template-columns minmax(260px, 1.8fr) repeat(3, minmax(90px, .7fr))
  align-items center
  min-width 720px

.subscription-compare-head
  background #f6f9ff
  border-bottom 1px solid #dbe3ef

  span,
  strong
    padding 12px 14px
    color #1f2937
    font-size 13px

.subscription-compare-group + .subscription-compare-group
  border-top 1px solid #dbe3ef

.subscription-compare-title
  padding 10px 14px
  background #fbfcff
  color #475467
  font-size 12px
  font-weight 600

.subscription-compare-row
  border-top 1px solid #edf1f7

  > span
    padding 11px 14px
    color #344054
    line-height 1.45

    &:not(:first-child)
      text-align center

.subscription-compare-cell
  display inline-flex
  align-items center
  justify-content center
  min-width 20px
  color #98a2b3

  &.included
    color #1677ff

  .anticon
    font-size 15px

.subscription-release-note
  .cn-settings-section-title span
    max-width 860px

@media (max-width 1180px)
  .subscription-plan-grid
    grid-template-columns 1fr

  .subscription-compare
    overflow-x auto

@media (max-width 640px)
  .subscription-settings
    .cn-settings-section-title
      align-items flex-start
      flex-direction column
      gap 4px

      span
        max-width none

  .subscription-current-card
    align-items flex-start
    flex-direction column

    .ant-tag
      align-self flex-start

  .subscription-plan-card
    min-height auto
    padding 12px

  .subscription-plan-head
    align-items flex-start

    .ant-tag
      flex-shrink 0
