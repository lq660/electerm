    padding 8px
    border 1px solid transparent
    border-radius 6px
    background transparent
    color #344054
    text-align left

    &:hover,
    &.active
      border-color #b8d2ff
      background #eef5ff

    strong,
    span,
    em
      display block
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

    strong
      font-size 13px

    span
      color #667085
      font-size 11px

    em
      color #667085
      font-size 12px
      font-style normal

.solution-record-library-empty
  padding 40px 12px
  color #98a2b3
  font-size 12px
  text-align center

.solution-record-detail
  min-width 0
  overflow-y auto
  padding 16px
  background #fff

  section
    margin-top 14px

    > b
      display block
      margin-bottom 5px
      color #344054
      font-size 12px

    p
      margin 0
      color #667085
      font-size 13px
      line-height 20px
      white-space pre-wrap

.solution-record-detail-head
  display flex
  align-items flex-start
  justify-content space-between
  gap 10px

  > div:first-child
    min-width 0

  strong,
  span
    display block
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    color #1f2937
    font-size 16px
    line-height 22px

  span
    margin-top 3px
    color #667085
    font-size 12px

.solution-record-detail-actions
  display flex
  gap 6px

  button
    height 28px
    display inline-flex
    align-items center
    justify-content center
    padding 0 8px
    border 1px solid #d8e0ea
    border-radius 6px
    background #fff
    color #667085

    &:hover
      border-color #1677ff
      color #1677ff

.solution-record-command-title
  display flex
  align-items center
  justify-content space-between
  gap 8px
  margin-bottom 6px

  span
    color #98a2b3
    font-size 12px

.solution-record-command
  display grid
  grid-template-columns minmax(0, 1fr) 28px
  gap 6px
  align-items center
  margin-top 6px
  padding 6px 8px
  border 1px solid #d8e0ea
  border-radius 6px
  background #f8fafc

  code
    min-width 0
    overflow hidden
    color #344054
    font-size 12px
    text-overflow ellipsis
    white-space nowrap

  button
    width 28px
    height 28px
    display flex
    align-items center
    justify-content center
    padding 0
    border 0
    border-radius 5px
    background transparent
    color #667085

    &:hover
      background #e6f1ff
      color #1677ff

.solution-record-tags
  display flex
  flex-wrap wrap
  gap 5px
  margin-top 14px

  span
    padding 2px 6px
    border-radius 5px
    background #eef5ff
    color #1677ff
    font-size 12px

.solution-record-run-actions
  display flex
  gap 8px
  margin-top 16px

  button
    height 32px
    display inline-flex
    align-items center
    justify-content center
    gap 6px
    padding 0 10px
    border 1px solid #d8e0ea
    border-radius 6px
    background #fff
    color #344054

    &:hover
      border-color #1677ff
      color #1677ff

    &.primary
      border-color #1677ff
      background #1677ff
      color #fff

      &:hover
        background #0958d9
        color #fff

@media (max-width: 760px)
  .solution-record-modal .custom-modal-content
    width calc(100vw - 24px) !important

  .solution-record-library
    grid-template-columns 1fr

  .solution-record-library-list
    max-height 180px
    border-right 0
    border-bottom 1px solid #d8e0ea

.cn-session-aside-title
  color #344054
  font-size 12px
  font-weight 700
  margin-bottom 6px

.cn-session-info-row
  display flex
  align-items center
  justify-content space-between
  gap 8px
  min-height 22px
  color #667085
  font-size 12px

  b
    min-width 0
    color #1f2937
    font-weight 600
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.cn-session-empty-metrics
  display flex
  flex-direction column
  gap 4px
  padding 8px
  border 1px dashed #b8d8ff
  border-radius 8px
  background #f5f8ff
  color #667085
  font-size 12px
  line-height 1.5

.cn-session-metrics
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 6px 8px

  > div
    min-width 0
    display flex
    flex-direction column
    gap 2px

    &.wide
      grid-column 1 / -1

  span
    color #667085
    font-size 11px

  b
    color #1f2937
    font-size 12px
    font-weight 600
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.cn-session-metrics-loading
  color #667085
  font-size 12px
  line-height 24px

@media (max-width: 980px)
  .cn-session-aside
    display none

.web-session-wrap
  height 100%
  background var(--main)
  overflow hidden
  display flex
  flex-direction column
.web-session-content
  flex 1
  min-height 0
  overflow hidden
.session-v-info
  line-height 30px
.vnc-scroll-wrapper
  position relative
  background var(--main)
  z-index 299
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--main-darker)
  &::-webkit-scrollbar-track
    background var(--main-darker)
    box-shadow inset 0 0 5px var(--main-darker)
  &::-webkit-scrollbar-thumb
    background var(--primary)
    border-radius 0
  &::-webkit-scrollbar-corner
    background var(--main-darker)

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none

.sess-icon
  margin-right 10px
  &.active
    color var(--warn)

.session-aside-toolbar-toggle
  color #667085

  &:hover
    color #1677ff

.cn-transfer-toolbar-toggle
  position relative

  &.has-transfer::after
    content ''
    position absolute
    top 3px
    right 3px
    width 6px
    height 6px
    border-radius 50%
    background #fa8c16
    box-shadow 0 0 0 2px #fff

.split-view-toggle
  border 0
  background transparent
  color inherit
  font-family inherit
  cursor pointer
  &.active
    color var(--success)
