.connection-import-modal
  .custom-modal-body
    padding 18px 22px 20px !important

  // 2026-07-12 coder(lq): The modal is mounted inside the compact resource toolbar, so its footer buttons must not inherit the toolbar's icon-only width.
  .custom-modal-footer .ant-btn
    width auto !important
    min-width 76px !important
    height 32px !important
    padding 4px 15px !important
    overflow hidden !important

  .custom-modal-footer .connection-import-confirm
    min-width 156px !important
    border-color #1677ff !important
    background #1677ff !important
    color #fff !important

    &:hover
      border-color #0958d9 !important
      background #0958d9 !important
      color #fff !important

.connection-import-content
  display flex
  flex-direction column
  gap 14px

.connection-import-summary
  display grid
  grid-template-columns 1fr 2fr 1fr
  border 1px solid #d8e0ea
  border-radius 8px
  background #f8fafc
  overflow hidden

  > div
    min-width 0
    padding 10px 14px
    border-right 1px solid #e4e9f1

    &:last-child
      border-right 0

  span,
  strong
    display block

  span
    color #667085
    font-size 12px
    line-height 20px

  strong
    overflow hidden
    color #1f2937
    font-size 14px
    line-height 22px
    text-overflow ellipsis
    white-space nowrap

.connection-import-table
  overflow hidden
  border 1px solid #d8e0ea
  border-radius 8px

  .ant-table-thead > tr > th
    background #f8fafc !important
    color #344054 !important
    font-size 12px

  .ant-table-tbody > tr > td
    color #344054 !important
    border-color #edf1f7 !important

.connection-import-conflict
  display flex
  align-items center
  justify-content space-between
  gap 20px
  padding 12px 14px
  border 1px solid #d8e0ea
  border-radius 8px
  background #fbfdff

  > div
    min-width 180px

  strong,
  span
    display block

  strong
    color #1f2937
    font-size 13px

  span
    margin-top 2px
    color #667085
    font-size 12px

@media (max-width: 760px)
  .connection-import-summary
    grid-template-columns 1fr

    > div
      border-right 0
      border-bottom 1px solid #e4e9f1

      &:last-child
        border-bottom 0

  .connection-import-conflict
    align-items flex-start
    flex-direction column
