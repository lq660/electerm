  .cn-bookmark-form .ant-tabs
    background #fff

  .cn-bookmark-form .ant-tabs-nav
    margin 0
    padding 0 22px
    background #fff
    border-bottom 1px solid $cn-border

  .cn-bookmark-form .ant-tabs-tab
