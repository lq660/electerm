.input-confirm
  width 100%
  display flex
  .ant-input-number
    flex 1

.icon-button
  display inline-flex
  align-items center
  justify-content center
  padding 2px
  border 0
  background transparent
  color inherit
  cursor pointer
  border-radius 3px
  &:hover
    color var(--primary)
  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset 1px
