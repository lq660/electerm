.ai-conversation-turns
  min-width 0

.chat-history-item
  position relative
  margin 0
  padding 8px 10px 9px

  & + .chat-history-item
    border-top 1px solid $ai-border-soft

.ai-history-turn-header
  display flex
  align-items flex-start
  gap 5px
  min-width 0
  min-height 22px

.ai-history-item-prompt
  min-width 0
  flex 1 1 auto
  color $ai-muted-strong
  font-size 11px
  font-weight 600
  line-height 18px
  overflow-wrap anywhere

.ai-history-queued-status
  flex 0 0 auto
  align-self center
  padding 2px 6px
  border-radius 10px
  background #f2f4f7
  color $ai-muted
  font-size 10px
  line-height 15px
  white-space nowrap

.cn-ai-agent-status.status-queued
  border-color #d0d5dd
  background #f8f9fb

  .cn-ai-agent-status-dot
    background #667085

.ai-history-inline-actions
  display flex
  flex 0 0 auto
  align-items center
  gap 2px

.ai-history-toggle,
.ai-history-meta-action
  display inline-flex
  align-items center
  justify-content center
  width 22px
  height 22px
  padding 0
  border 0
  border-radius 4px
  background transparent
  color $ai-muted

  &:hover
    background $ai-primary-tint
    color $ai-primary

  &:focus-visible
    outline 2px solid $ai-primary-border
    outline-offset 0

.ai-history-item-body
  min-width 0
  margin 2px 0 0 10px
  padding 1px 0 0 11px
  border-left 1px solid $ai-border-soft

.agent-tool-header
  align-items center
  flex-wrap nowrap

.agent-tool-toggle
  min-width 0

.agent-tool-command-preview
  min-width 32px
  max-width none
  flex 1 1 auto

.agent-tool-header-actions
  display flex
  flex 0 0 auto
  align-items center
  gap 4px

  .ant-tag
    margin-inline-end 0

.agent-tool-tag,
.agent-tool-risk-tag
  margin 0

@media (max-width: 520px)
  .cn-ai-history-toolbar
    flex-wrap wrap

  .cn-ai-history-toolbar > .ai-history-search-toolbar
    order 3
    width 100%
    max-width none
    margin 2px 0 0

  .ai-conversation-group-header
    flex-wrap wrap
    padding-right 8px
    padding-left 8px

  .ai-history-search
    order 3
    width 100%
    min-width 0
    flex-basis 120px

    .ai-history-search-count
      display none

  .chat-history-item
    padding-right 8px
    padding-left 8px

  .agent-tool-header
    align-items flex-start
    flex-wrap wrap

  .agent-tool-toggle
    width 100%
    flex-basis 100%

  .agent-tool-header-actions
    width 100%
    justify-content flex-end
    padding-left 22px

  .agent-tool-command-kind
    display none

  .agent-tool-confirm-button span
    display inline !important

  .cn-ai-agent-status
    align-items flex-start
    flex-wrap wrap

  .cn-ai-agent-status-actions
    width 100%
    justify-content flex-end
    padding-left 15px

// 2026-08-30 coder(lq): The AI panel can be narrow inside a wide desktop window, so responsive rules must follow the panel rather than the viewport.
@container (max-width: 520px)
  .ai-chat-container
    .ai-chat-history
      padding-right 8px
      padding-left 8px

    .ai-chat-input
      padding-right 8px
      padding-left 8px

      .ai-chat-terminals
        right 16px
        left 16px

  .cn-ai-history-toolbar
    flex-wrap wrap

  .cn-ai-history-toolbar > .ai-history-search-toolbar
    order 3
    width 100%
    max-width none
    margin 2px 0 0

  .ai-conversation-group-header
    flex-wrap wrap
    padding-right 8px
    padding-left 8px

  .ai-history-search
    order 3
    width 100%
    min-width 0
    flex-basis 120px

    .ai-history-search-count
      display none

  .chat-history-item
    padding-right 8px
    padding-left 8px

  .agent-tool-header
    align-items flex-start
    flex-wrap wrap

  .agent-tool-toggle
    width 100%
    flex-basis 100%

  .agent-tool-header-actions
    box-sizing border-box
    width 100%
    flex-wrap wrap
    justify-content flex-end
    padding-left 22px

  .agent-tool-command-kind
    display none

  .agent-tool-confirm-button span
    display inline !important

  .cn-ai-agent-status
    align-items flex-start
    flex-wrap wrap

  .cn-ai-agent-status-actions
    box-sizing border-box
    width 100%
    flex-wrap wrap
    justify-content flex-end
    padding-left 15px

// 2026-08-30 coder(lq): Use one Codex-like transcript surface for the active task; status, turns and tool output should read as one continuous work log instead of nested cards.
.ai-history-surface
  box-sizing border-box
  flex 0 0 auto
  width 100%
  min-width 0
  min-height 100%
  overflow hidden
  border 1px solid $ai-border
  border-radius 8px
  background $ai-panel

  .cn-ai-history-navigator
    margin 0
    padding 8px 10px 6px
    border-bottom 1px solid $ai-border-soft
    background $ai-panel

  .cn-ai-config-notice
    margin 0
    border-width 0 0 1px
    border-radius 0

  .cn-ai-agent-status
    margin 0
    border-width 0 0 1px
    border-radius 0
    background transparent

  .ai-conversation-group
    margin 0
    border 0
    border-radius 0
    background transparent

    & + .ai-conversation-group
      border-top 1px solid $ai-border

    &.is-multi-round
      padding 0
      border 0
      border-radius 0
      background transparent

      .chat-history-item
        margin-bottom 0

  .ai-conversation-group-header
    padding 10px 10px 8px
    border-bottom 1px solid $ai-border-soft
    background $ai-panel-muted

  .chat-history-item
    padding-right 10px
    padding-left 10px

  .agent-tool-call-card
    margin 6px 0
    border 0 !important
    border-left 2px solid $ai-border !important
    border-radius 0 !important
    background transparent !important

    &.agent-tool-running
      border-left-color $ai-primary !important

    &.agent-tool-completed
      border-left-color $ai-success !important

    &.agent-tool-pending_confirm
      border-left-color $ai-warning !important

    &.agent-tool-error
      border-left-color $ai-danger !important

  .agent-tool-header
    background $ai-panel-muted

  .agent-tool-detail
    padding-bottom 3px

  .ai-solution-record-actions
    padding-bottom 2px

// 2026-08-30 coder(lq): Make the composer one compact editor surface; the input and toolbar should share one border instead of reading as nested cards.
.ai-chat-container
  .ai-chat-input
    margin 8px 0 0
    padding 0
    overflow hidden
    border 1px solid $ai-border
    border-radius 8px
    background $ai-panel
    box-shadow 0 2px 6px var(--workbench-shadow-sm, rgba(15, 23, 42, .04))

    .ant-input,
    textarea.ant-input
      min-height 108px
      padding 12px 14px 56px
      border 0 !important
      border-radius 7px
      background transparent !important
      box-shadow none !important
      color $ai-text !important
      font-size 13px
      line-height 20px
      resize none

      &:focus
        border 0 !important
        box-shadow none !important

    .ai-chat-textarea::placeholder
      color $ai-placeholder !important
      opacity 1

    .ai-chat-terminals
      position absolute
      right 0
      bottom 0
      left 0
      padding 7px 10px 9px
      border-top 1px solid $ai-border-soft
      background $ai-panel-muted

    .cn-ai-composer-toolbar
      display flex
      align-items center
      gap 8px
      min-width 0

    .cn-ai-target-select
      min-width 0
      flex 1 1 auto

    .cn-ai-agent-target
      height 24px
      padding 0 8px
      border 0
      background transparent
      color $ai-muted-strong
      font-size 11px
      font-weight 600

    .cn-ai-action-icons
      gap 1px

      > span,
      .cn-ai-icon-button
        width 28px
        height 28px
        flex-basis 28px

    .cn-ai-send-button
      // 2026-08-31 coder(lq): Keep the send control aligned with the 28px settings control on compact layouts.
      width 28px
      height 28px
      flex-basis 28px
      margin-left 2px
      border-radius 50%
      background $ai-primary-strong
      color #fff

      &:hover
        background $ai-primary-hover
        color #fff

      &.disabled
        background $ai-border
        color $ai-placeholder

@container (max-width: 520px)
  .ai-chat-container
    .ai-chat-input
      margin-right 8px
      margin-left 8px

      .ai-chat-terminals
        padding-right 7px
        padding-left 7px

      .cn-ai-composer-toolbar
        gap 4px

      .cn-ai-new-session-indicator
        display none

// 2026-08-31 coder(lq): Embedded AI uses the full sidebar width; the outer session shell owns its gutters.
.ai-chat-container.ai-chat-embedded
  .ai-chat-history
    padding-right 0
    padding-left 0

  .ai-chat-input
    margin-right 0
    margin-left 0

// 2026-09-09 coder(lq): Keep the editor, attachments and toolbar in normal flow so added files cannot cover the text or send controls.
.ai-chat-container .ai-chat-input.cn-ai-composer
  display flex
  flex-direction column

  textarea.ant-input
    padding 12px 14px
    min-height 164px !important
    max-height clamp(164px, 35vh, 264px) !important
    overflow-y auto !important

  .ai-chat-terminals
    position static
    flex-shrink 0

  .cn-ai-target-select
    font-size 12px
    color $ai-muted

  button:focus-visible
    outline 2px solid $ai-primary
    outline-offset 2px

  button:disabled
    opacity .45
    cursor not-allowed

.cn-ai-attachments
  display flex
  flex-wrap wrap
  gap 6px
  padding 8px 12px 0
  max-height 104px
  overflow-y auto

.cn-ai-attachment
  display flex
  align-items center
  gap 6px
  max-width 100%
  min-width 0
  padding 4px 6px
  border 1px solid $ai-border
  border-radius 6px
  background $ai-panel-muted
  color $ai-text
  font-size 12px

  img
    width 30px
    height 30px
    object-fit cover
    border-radius 3px

  > span:not(.anticon)
    max-width 180px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  > .anticon
    font-size 20px
    color $ai-primary

  button
    flex-shrink 0
    width 24px
    height 24px
    padding 0
    border 0
    border-radius 4px
    background transparent
    color $ai-muted-strong
    cursor pointer

    &:hover
      background $ai-border-soft

.cn-ai-attachment-error
  padding 4px 12px 8px
  color $ai-danger
  font-size 12px
  white-space pre-wrap

// 2026-09-09 coder(lq): Scope the transcript to override legacy sidebar cards without changing other history views.
.ai-conversation-group.ai-chat-conversation
  border 0
  border-radius 0
  background transparent

  > .ai-conversation-group-header
    padding 8px 16px
    border 0
    background transparent

  .ai-conversation-group-title strong
    color $ai-muted
    font-size 12px
    font-weight 400

  .ai-conversation-turns .chat-history-item.ai-chat-turn
    display flex
    flex-direction column
    gap 20px
    margin 0
    padding 12px 16px 24px
    border 0
    border-radius 0
    background transparent
    box-shadow none

  .ai-chat-user-message
    align-self flex-end
    max-width 88%
    min-width 0

    .ai-chat-message-meta
      justify-content flex-end

    .ai-history-queued-status
      display block
      margin-top 6px
      white-space normal

  .ai-chat-message-meta
    display flex
    align-items center
    gap 8px
    min-height 28px
    margin-bottom 4px
    color $ai-muted
    font-size 12px

    .ai-history-meta-action
      width 28px
      height 28px

  .ai-chat-user-bubble
    padding 10px 14px
    border-radius 14px 14px 4px 14px
    background $ai-primary-tint
    color $ai-text
    font-size 13px
    line-height 1.65
    overflow-wrap anywhere

    .cn-ai-attachments
      padding 8px 0 0

  .ai-chat-user-text
    white-space pre-wrap

  .ai-chat-assistant-message
    min-width 0
    width 100%
    overflow-wrap anywhere

    .ai-stream-output > .pd1
      padding 0

    .ai-solution-record-actions
      justify-content flex-start
      margin-top 8px
      padding 0

      button
        min-height 28px
        padding 4px 6px
        border-color transparent
        background transparent
        color $ai-muted

        &:hover
          background $ai-primary-tint
          color $ai-primary

  .ai-chat-message-placeholder
    color $ai-muted
    font-size 13px
    line-height 1.65
