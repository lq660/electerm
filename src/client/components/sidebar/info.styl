
// from https://freefrontend.com/css-border-animations/
.morph-shape
 	background linear-gradient(45deg, #08c 0%, #09c 100%)
  border-radius 60% 40% 30% 70% / 60% 30% 70% 40%
  transition all 1s ease-in-out
  z-index 5

// 2026-07-04 coder(lq): About dialog is part of the product shell, so make it readable and brand it as the customized workbench while preserving upstream project links.
.info-modal
  .custom-modal-content
    background #fff !important
    color #1f2937 !important

  .about-wrap
    color #344054 !important

    .ant-tabs-nav
      margin 0 0 16px !important

    .ant-tabs-tab
      color #667085 !important

      &:hover
        color #1677ff !important

    .ant-tabs-tab-active .ant-tabs-tab-btn
      color #1677ff !important
      font-weight 700 !important

    p,
    div,
    span,
    b,
    li
      color inherit

    a
      color #1677ff !important

      &:hover
        color #0958d9 !important

    pre
      padding 12px !important
      border 1px solid #d8e0ea !important
      border-radius 8px !important
      background #f8fafc !important
      color #1f2937 !important
      white-space pre-wrap

  .cn-about-page
    width 100%

  .cn-about-hero
    display flex
    align-items center
    gap 14px
    margin 8px 0 18px
    padding 16px
    border 1px solid #d8e0ea
    border-radius 8px
    background #fbfdff

    strong
      display block
      color #1f2937
      font-size 22px
      line-height 30px

    span,
    em
      display block
      margin-top 3px
      color #667085
      font-style normal
      line-height 20px

  .cn-about-logo
    display flex
    align-items center
    justify-content center
    width 48px
    height 48px
    border-radius 8px
    background #1677ff
    color #fff
    font-size 22px
    font-weight 700

  .cn-about-facts
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap 12px
    margin 0 0 18px

    div
      padding 12px 14px
      border 1px solid #d8e0ea
      border-radius 8px
      background #f8fafc

    b,
    span
      display block

    b
      color #1f2937

    span
      margin-top 6px
      color #667085
      line-height 20px

  .cn-about-open-source
    padding 14px
    border 1px solid #d8e0ea
    border-radius 8px
    background #fff

    h3
      margin 0 0 8px
      color #1f2937
      font-size 16px

    p
      margin 0 0 8px

    p:last-child
      margin-bottom 0
