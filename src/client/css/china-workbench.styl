      display block
      color $cn-text
      font-weight 700
      font-size 14px
      padding 4px 8px 12px

    .setting-row-left .tree-item
      margin 2px 0

    .setting-row-left .tree-item-title
      font-size 13px

  .setting-tabs-setting
