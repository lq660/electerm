.transports-wrap
  position absolute
  left 60px
  top 3px
  right 60px
  height 36px

.transports-circle-wrap
  text-align center
  position relative
  z-index 10
.transports-dd
  position absolute
  left 0
  right 0
  overflow-y scroll
  z-index 11
  background var(--main)

.transports-wrap
  .transports-dd
    display none
  &:hover .transports-dd
    display block

.transports-title
  border-bottom 1px solid var(--primary)
  padding 10px 15px
.transports-content
  max-height 200px
  padding 10px 0
.sftp-transport
  display flex
  padding 8px 5px
  &:hover
    font-weight bold
  .transfer-control-icon
    padding-right 5px
    padding-left 5px
    margin-top -2px
    &:hover
      color var(--primary-contrast)
      background var(--primary)
      border-radius 20px

.flex-child + .flex-child
  margin-left 5px
  flex-grow 1
.transfer-control-icon
  margin-right 3px
  margin-top 3px

// 2026-07-02 coder(lq): Transfer dropdown is part of the workbench shell and should not fall back to the legacy dark menu.
.transports-dd
  background #fff !important
  color #1f2937 !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  box-shadow 0 16px 40px rgba(15, 23, 42, .14) !important

.transports-title
  background #fbfdff !important
  border-bottom 1px solid #d8e0ea !important
  color #1f2937 !important
  font-weight 700

.sftp-transport
  color #344054 !important
  border-radius 6px !important
  margin 0 8px 4px
  &:hover
    background #eef5ff !important
    color #1677ff !important
    font-weight 600

.transfer-control-icon:hover
  color #fff !important
  background #1677ff !important
