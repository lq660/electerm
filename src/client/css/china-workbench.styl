      margin-right 6px
      border-left-width 1px
      height 30px
      line-height 28px
      font-size 13px

      &:before
        display none

    .ant-radio-button-wrapper-checked
      background $cn-primary !important
      border-color $cn-primary !important
      color #fff !important

  .cn-bookmark-form form,
  .cn-bookmark-form .ant-form
