.sftp-wrap
  display flex
  flex-direction row
.sftp-section
  flex 1
.sftp-title-wrap
  position relative
.sftp-item
  position relative
  z-index 3
  padding 0
  line-height 26px
  height 32px
  user-select none
  margin-bottom 4px
  &:nth-child(even)
    .sftp-file-prop
      background var(--main)
  &:hover
    .sftp-file-prop
      background-color var(--primary)
      color var(--primary-contrast)
  &.selected
    .sftp-file-prop
      background-color var(--primary)
      color var(--primary-contrast)
.sftp-history
  position absolute
  left 0
  top 100%
  right 0
  z-index 30
  box-shadow none
  border none
  height 0
  background var(--main)
  overflow hidden
  border-radius 3px
  &.focused
    height auto
    border 1px solid var(--main-darker)
    box-shadow 0px 0px 3px 3px var(--main-lighter)

.sftp-history-item
  padding 5px 10px
  cursor pointer
  border-bottom 1px solid var(--main-darker)
  &:hover
    background var(--primary)
    color var(--primary-contrast)

.sftp-item-title
  width 100%
.sftp-item-title
    width 75%
.sftp-item-size
  width 24%
.sftp-status-success
  color var(--success)
.sftp-status-exception
  color var(--error)
.sftp-status-active
  color var(--primary)

.virtual-file
  .sftp-item
    position absolute
    left 0
    right 10px
    bottom 0
    top 0
    z-index 1
    height 100%
    padding 0
    margin 0

.file-icon
  position absolute
  left 10px
  top 10px
  font-size 50px
.file-props-div
  display flex
  width 100%
.file-props
  margin-left 70px

.sftp-sort-btn
  &.active
    font-weight bold
    color var(--text-light)

//list table
.sftp-file-prop
  flex 0 0 auto
  height 32px
  line-height 30px
  padding 0 5px
  background var(--main)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  pointer-events none
  cursor default
  color var(--text)

.file-bg
  position absolute
  left 0
  top 0
  right 0
  height 32px
  z-index 3

.sftp-header-item
  height 28px
  line-height 25px
  padding 0 5px
  background var(--main)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.sftp-file-table-header
  height 30px
.sftp-table
  z-index 2
  &:hover
    ::-webkit-scrollbar
      width 12px
.sftp-item
  &.sftp-dragover
    .sftp-file-prop
      background var(--primary) !important
      color var(--text) !important
  &.sftp-dragover-multi
    &:after
    &:before
      position absolute
      left 2px
      top 2px
      width 100%
      height 100%
      background var(--main-lighter)
      content ''
      z-index -1
    &:after
      left 4px
      top 4px
.icon-holder
  width 1em
  display inline-block
.symbolic-link-icon
  margin-right 2px

//sftp
.sftp-panel
  background var(--main)

.sftp-terminal-cwd-sync
  height 28px
  display inline-flex
  align-items center
  gap 6px
  flex 0 0 auto
  padding 0 10px
  border 1px solid #b9d2ff
  border-radius 6px
  background #eef5ff
  color #1677ff
  font-size 12px
  cursor pointer

  &:hover
    border-color #1677ff
    background #e4efff

  &:disabled
    cursor default
    opacity .65

.sftp-terminal-cwd-sync-arrow
  font-size 10px

.file-list
  ::-webkit-scrollbar-thumb
    background-color var(--primary) !important

.pager-wrap
  z-index 4
  position relative

.sftp-has-pager
  .sftp-table-content
    padding-bottom 42px
  .pager-wrap
    position absolute
    bottom 0
    left 0
    width 100%
    background var(--main)
    height 40px
    border-top 1px solid var(--main-darker)

.file-header-context-menu
  position fixed
  z-index 999

.keyword-filter-icon
  &:hover
  &.active
    color var(--success)

// 2026-07-02 coder(lq): SFTP file manager is an operational page, so use dense light tables instead of inherited dark terminal surfaces.
.sftp-wrap,
.sftp-section,
.sftp-panel
  background #f5f7fb !important
  color #1f2937 !important

.sftp-title-wrap,
.sftp-file-table-header,
.sftp-header-item,
.pager-wrap
  background #fbfdff !important
  color #344054 !important
  border-bottom 1px solid #d8e0ea !important

.sftp-file-prop,
.sftp-item:nth-child(even) .sftp-file-prop
  background #fff !important
  color #344054 !important
  border-bottom 1px solid #edf1f7 !important

.sftp-item:hover .sftp-file-prop,
.sftp-item.selected .sftp-file-prop,
.sftp-item.sftp-dragover .sftp-file-prop
  background #eef5ff !important
  color #1677ff !important

.sftp-history
  background #fff !important
  border 1px solid #d8e0ea !important
  border-radius 8px !important
  box-shadow 0 12px 30px rgba(15, 23, 42, .14) !important

.sftp-history-item
  color #344054 !important
  border-bottom 1px solid #edf1f7 !important
  &:hover
    background #eef5ff !important
    color #1677ff !important

.sftp-has-pager .pager-wrap
  background #fbfdff !important
  border-top 1px solid #d8e0ea !important
