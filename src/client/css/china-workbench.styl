  .cn-setting-header
    height 86px
    display flex
    align-items center
    justify-content space-between
    padding 14px 24px 14px 58px
    background linear-gradient(90deg, #ffffff 0%, #f7fbff 58%, #f8fffd 100%)
    border-bottom 1px solid $cn-border
    box-shadow 0 6px 18px rgba(15, 23, 42, .05)

  .cn-setting-brand
    display flex
    align-items center
    gap 12px

    strong
      display block
      font-size 18px
      color $cn-text
      line-height 24px

    em
      display block
      font-style normal
      color $cn-muted
      font-size 12px
